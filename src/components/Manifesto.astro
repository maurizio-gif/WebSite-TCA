---
import { getLocalePath, type Lang } from '../i18n/utils';
interface Props { lang?: Lang; }
const { lang = 'it' } = Astro.props;
const p = (path: string) => getLocalePath(lang, path);

const copy = lang === 'en' ? {
  title:  'A club built on tradition,<br>made for today.',
  p1:     "TC Ambrosiano has been promoting sporting excellence and healthy activity for experts and beginners alike for more than 60 years. Home to the <strong>Avvenire Tournament</strong>, TCA has hosted one of the world's top junior tennis competitions since 1965 and produced many champions. From that same calling, our passion to deliver the best training for everyone, every day, was born.",
  p2:     "Here you'll find some of the finest racquets, sporting facilities and healthy activities in east Milan: <strong>tennis courts, padel courts, pickleball, athletic training spaces</strong> and an activity and social calendar for every age. Whether you want to get back on court, raise a child through sport, or simply take care of yourself following a wide range of courses and programmes for every age and ability, the Club makes it easy. Our expert team make sport and healthy activity of all types rewarding, effective and fun.",
  cta:    'Discover our history →',
  cta2:   'Discover our programmes →',
} : {
  title:  'Un club fondato<br>sulla tradizione,<br><em>costruito per il presente.</em>',
  p1:     "TC Ambrosiano promuove l'eccellenza sportiva e l'attività motoria, per esperti e principianti, da oltre 60 anni. Casa del <strong>Torneo Avvenire</strong>, il TCA ospita dal 1965 una delle competizioni giovanili di tennis più prestigiose al mondo e ha formato numerosi campioni. Da quella stessa vocazione nasce la nostra passione: offrire il miglior allenamento a tutti, ogni giorno.",
  p2:     "Qui trovi alcune delle migliori racchette, strutture sportive e attività per il benessere della zona est di Milano: <strong>campi da tennis, campi da padel, pickleball, spazi per la preparazione atletica</strong> e un calendario di attività ed eventi sociali per ogni età. Che tu voglia tornare in campo, far crescere un figlio nello sport o semplicemente prenderti cura di te seguendo un'ampia offerta di corsi e programmi per ogni età e livello, il Club te lo rende semplice. Il nostro team di esperti rende lo sport e l'attività motoria di ogni tipo gratificanti, efficaci e divertenti.",
  cta:    'Scopri la nostra storia →',
  cta2:   'Scopri i nostri programmi →',
};
---

<section class="manifesto">
  <div class="manifesto__inner">
    <h2 class="manifesto__title" data-anim="reveal" set:html={copy.title} />

    <div class="manifesto__right">
      <div class="manifesto__body" data-anim="from-left" data-anim-delay="150">
        <p set:html={copy.p1} />
        <p set:html={copy.p2} />
      </div>
      <div class="manifesto__ctas">
        <a class="btn btn-red manifesto__cta" href={p('/storia')} data-anim="from-left" data-anim-delay="280">
          {copy.cta}
        </a>
        <a class="btn btn-outline--dark manifesto__cta" href={p('/planning')} data-anim="from-left" data-anim-delay="320">
          {copy.cta2}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto { padding: 8vh var(--pad-x); }

  .manifesto__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .manifesto__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.95;
  }
  .manifesto__title em { color: var(--color-accent); font-style: normal; }

  .manifesto__right {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .manifesto__body p {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.05vw, 19px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text-light);
  }

  .manifesto__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 860px) {
    .manifesto__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
