---
import { getEntry } from 'astro:content';
import { useTranslations, getLocalePath, publicUrl, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'it' } = Astro.props;
const t = useTranslations(lang);
const p = (path: string) => getLocalePath(lang, path);

// PDF legali gestibili da TinaCMS → src/content/legal/documenti.md
const legal = (await getEntry('legal', 'documenti'))!.data;

const columns = [
  {
    heading: t.footer.adulti,
    links: [
      { label: t.nav.tennis,       href: p('/tennis') },
      { label: t.nav.padel,        href: p('/padel') },
      { label: t.nav.prepAtletica, href: p('/preparazione-atletica') },
    ],
  },
  {
    heading: t.footer.junior,
    links: [
      { label: t.nav.scuolaTennis, href: p('/scuola-tennis') },
      { label: t.nav.summerCamps,  href: p('/summer-camps') },
      { label: t.nav.agonistica,   href: p('/agonistica') },
    ],
  },
  {
    heading: t.footer.ilClub,
    links: [
      { label: t.nav.torneoAvvenire, href: p('/torneo-avvenire') },
      { label: t.nav.storia,         href: p('/storia') },
      { label: t.nav.eventi,         href: p('/eventi') },
      { label: t.footer.diventaSocio, href: '#' }, // TODO: PerfectGym
    ],
  },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <img
        src={publicUrl('/logos/tca-logo.png')}
        alt="TC Ambrosiano"
        class="footer__logo"
        width="100"
        height="68"
      />
      <p class="footer__tagline">{t.footer.tagline}</p>
    </div>

    {columns.map((col) => (
      <div class="footer__col">
        <h3 class="footer__heading">{col.heading}</h3>
        <ul class="footer__list">
          {col.links.map((l) => (
            <li><a class="footer__link" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}

    <div class="footer__col">
      <h3 class="footer__heading">{t.footer.contatti}</h3>
      <ul class="footer__list">
        <li><span class="footer__text">{t.footer.address}</span></li>
        <li><a class="footer__link" href="tel:+390226414392">{t.footer.phone}</a></li>
        <li><a class="footer__link" href={`mailto:${t.footer.email}`}>{t.footer.email}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">{t.footer.social}</h3>
      <div class="footer__social">
        <a
          class="footer__social-link footer__social-link--instagram"
          href="https://www.instagram.com/clubambrosiano"
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
        >
          <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span class="footer__social-label">Instagram</span>
        </a>
        <a
          class="footer__social-link footer__social-link--facebook"
          href="https://www.facebook.com/tcambrosiano"
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
        >
          <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036c-1.751 0-2.6.6-2.6 2.3v1.671h3.259l-.6 3.667h-2.659v7.98H9.101z"/>
          </svg>
          <span class="footer__social-label">Facebook</span>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">{t.footer.legal}</h3>
      <ul class="footer__list">
        <li><a class="footer__link" href={p('/regolamento')}>{t.footer.regolamento}</a></li>
        <li><a class="footer__link" href={p('/privacy-policy')}>{t.footer.privacy}</a></li>
        {legal.codice_condotta && (
          <li><a class="footer__link" href={publicUrl(legal.codice_condotta)} target="_blank" rel="noopener">{t.footer.modelloCondotta}</a></li>
        )}
        {legal.nomina_responsabile && (
          <li><a class="footer__link" href={publicUrl(legal.nomina_responsabile)} target="_blank" rel="noopener">{t.footer.nominaSafeguarding}</a></li>
        )}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <p class="footer__sign">{t.footer.sign}</p>
    </div>
  </div>
</footer>

<div class="powered-by">
  <a class="powered-by__link" href="https://www.ready2digital.it" target="_blank" rel="noopener">
    <span class="powered-by__text">Powered by</span>
    <img
      src={publicUrl('/logos/ready2digital.png')}
      alt="Ready2Digital"
      class="powered-by__logo"
      width="993"
      height="192"
      loading="lazy"
    />
  </a>
</div>

<style>
  .footer {
    background: #0f1013;
    color: #ffffff;
  }

  .footer__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 5vh var(--pad-x) 4vh;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__logo {
    height: 44px;
    width: auto;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: clamp(12px, 0.9vw, 14px);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer__heading {
    font-family: var(--font-display);
    font-size: clamp(11px, 0.9vw, 13px);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__link,
  .footer__text {
    font-family: var(--font-body);
    font-size: clamp(13px, 0.9vw, 15px);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.18s;
  }

  .footer__link { text-decoration: none; }
  .footer__link:hover { color: #fff; }

  .footer__social {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.9rem 0.55rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    text-decoration: none;
    color: rgba(255, 255, 255, 0.85);
    transition: background 0.2s, border-color 0.2s, transform 0.2s, color 0.2s;
    width: fit-content;
  }

  .footer__social-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .footer__social-label {
    font-family: var(--font-body);
    font-size: clamp(13px, 0.9vw, 15px);
    font-weight: 400;
  }

  .footer__social-link:hover {
    transform: translateY(-2px);
    border-color: transparent;
    color: #fff;
  }

  .footer__social-link--instagram:hover,
  .footer__social-link--facebook:hover {
    background: var(--color-accent);
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer__bottom-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.5rem var(--pad-x);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .footer__sign {
    font-family: var(--font-display);
    font-size: clamp(11px, 0.7vw, 11px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 1024px) {
    .footer__inner { grid-template-columns: 1fr 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .footer__inner { grid-template-columns: 1fr 1fr; }
    .footer__bottom-inner { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 400px) {
    .footer__inner { grid-template-columns: 1fr; }
  }

  .powered-by {
    background: var(--color-bg);
    padding: 0.9rem var(--pad-x);
    display: flex;
    justify-content: center;
  }

  .powered-by__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.18s;
  }
  .powered-by__link:hover { opacity: 1; }

  .powered-by__text {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-text-light);
  }

  .powered-by__logo {
    height: 14px;
    width: auto;
  }
</style>
