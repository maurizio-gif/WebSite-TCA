---
import LeadFormBody from "./LeadFormBody.astro";
import { publicUrl, type Lang } from '../i18n/utils';
import { getEntry } from 'astro:content';
import { bookingAvailability } from '../lib/bookingAvailability';

interface Props { lang?: Lang; standalone?: boolean; standaloneTitle?: string; standaloneEyebrow?: string; }
const { lang = 'it', standalone = false, standaloneTitle, standaloneEyebrow } = Astro.props;

const WEBHOOK_CHECK = '';
const WEBHOOK_LEAD  = '';

// Disponibilità degli appuntamenti (orari settimanali, durata slot, chiusure,
// interruttori di attivazione) gestibile da TinaCMS →
// src/content/disponibilita/appuntamenti.md
const dispDati = (await getEntry('disponibilita', 'appuntamenti'))!.data;
const availability = bookingAvailability(dispDati);

const lfi = lang === 'en' ? {
  eyebrow: 'Contact us',
  title:   "Let's talk.<br><em>We're here for you.</em>",
  sub:     "Do you have questions about membership, courses or the gym? Write to us, request a call back or book a visit to the Club. We'll get back to you as soon as possible.",
} : {
  eyebrow: 'Contattaci',
  title:   'Parliamone.<br><em>Siamo qui per te.</em>',
  sub:     "Hai domande sull'abbonamento, sui corsi o sulla sala attrezzi? Scrivici, richiedici una chiamata o prenota una visita al Club. Ti risponderemo nel più breve tempo possibile.",
};
---

<section class={standalone ? "lfi lfi--standalone" : "lfi"}>

  <!-- Masthead: logo + titolo, solo in modalità standalone (landing da QR/link diretto) -->
  {standalone && (
    <div class="lfi__masthead">
      <img
        src={publicUrl('/logos/tca-logo.png')}
        alt="TC Ambrosiano"
        class="lfi__masthead-logo"
        width="225"
        height="224"
      />
      {standaloneEyebrow && <span class="lfi__masthead-eyebrow">{standaloneEyebrow}</span>}
      {standaloneTitle && <h1 class="lfi__standalone-title">{standaloneTitle}</h1>}
    </div>
  )}

  <div class="lfi__inner">

    <!-- Left: intro (nascosta in modalità standalone: solo form) -->
    {!standalone && (
      <div class="lfi__intro">
        <span class="eyebrow">{lfi.eyebrow}</span>
        <h2 class="lfi__title" set:html={lfi.title} />
        <p class="lfi__sub">{lfi.sub}</p>
      </div>
    )}

    <!-- Right: form panel -->
    <div class="lfi__panel" id="lfi-root" data-availability={JSON.stringify(availability)}>
      <LeadFormBody prefix="li" lang={lang} richiamataAttiva={availability.telefonico.attivo} visitaAttiva={availability.sede.attivo} />
    </div>

  </div>
</section>

<style>
  .lfi {
    padding: 7vh var(--pad-x) 8vh;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .lfi__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(3rem, 6vw, 8rem);
    align-items: start;
  }

  .lfi__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .lfi__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin: 0;
  }
  .lfi__title em { color: var(--color-accent); font-style: normal; }

  .lfi__sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.05vw, 18px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 44ch;
    margin: 0;
  }

  /* Panel form */
  .lfi__panel {
    background: var(--lm-bg);
    color: var(--lm-text);
    border: 1px solid var(--lm-border);
    display: flex;
    flex-direction: column;
  }

  /* Override step bar styling for inline context */
  .lfi__panel :global(.lm__steps) {
    background: var(--lm-bg-head);
    border-bottom: 1px solid var(--lm-border);
    border-top: 1px solid var(--lm-border);
  }

  @media (max-width: 900px) {
    .lfi__inner {
      grid-template-columns: 1fr;
    }
    .lfi__intro {
      position: static;
    }
    .lfi__sub { max-width: 100%; }
  }

  /* ══════════════════════════════════════════════════════════════
     Standalone: pagina a schermo intero, solo logo + titolo + form
     (landing da QR code/link diretto, pensata per smartphone)
  ══════════════════════════════════════════════════════════════ */
  .lfi--standalone {
    min-height: 100vh;
    padding: 0;
    border-top: none;
    background:
      radial-gradient(ellipse 120% 60% at 50% 0%, rgba(139, 26, 26, 0.5), transparent 65%),
      #0f1013;
  }

  .lfi__masthead {
    text-align: center;
    padding: 7vh var(--pad-x) 9vh;
  }

  .lfi__masthead-logo {
    height: 46px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.95;
    margin: 0 auto 18px;
  }

  .lfi__masthead-eyebrow {
    display: block;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 12px;
  }

  .lfi__standalone-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 8vw, 2.7rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #ffffff;
    margin: 0;
  }

  .lfi--standalone .lfi__inner {
    grid-template-columns: 1fr;
    max-width: 520px;
    width: 100%;
    margin: -7vh auto 0;
    padding: 0 var(--pad-x) 6vh;
    position: relative;
    z-index: 2;
  }

  .lfi--standalone .lfi__panel {
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 560px) {
    .lfi__masthead { padding: 6vh 20px 8vh; }
    .lfi--standalone .lfi__inner { padding: 0 16px 5vh; margin-top: -6vh; }
  }
</style>

<script>
  // @ts-nocheck — vanilla browser script (DOM access, no type annotations)
  import { initLeadForm } from '../lib/leadForm.client.js';

  var root = document.getElementById('lfi-root');
  if (root) {
    var form = initLeadForm(root, { prefix: 'li' });
    form.open(location.pathname, 'Form inline');
  }
</script>
