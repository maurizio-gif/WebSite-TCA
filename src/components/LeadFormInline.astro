---
import LeadFormBody from "./LeadFormBody.astro";
import type { Lang } from '../i18n/utils';

interface Props { lang?: Lang; standalone?: boolean; }
const { lang = 'it', standalone = false } = Astro.props;

const WEBHOOK_CHECK = '';
const WEBHOOK_LEAD  = '';

const lfi = lang === 'en' ? {
  eyebrow: 'Contact us',
  title:   "Let's talk.<br><em>We're here for you.</em>",
  sub:     "Do you have questions about membership, courses or the gym? Write to us, request a call back or book a visit to the Club. We'll get back to you as soon as possible.",
} : {
  eyebrow: 'Contattaci',
  title:   'Parliamone.<br><em>Siamo qui per te.</em>',
  sub:     "Hai domande sull'abbonamento, sui corsi o sulla sala attrezzi? Scrivici, richiedici una chiamata o prenota una visita al Club. Ti risponderemo nel più breve tempo possibile.",
};
---

<section class={standalone ? "lfi lfi--standalone" : "lfi"}>
  <div class="lfi__inner">

    <!-- Left: intro (nascosta in modalità standalone: solo form) -->
    {!standalone && (
      <div class="lfi__intro">
        <span class="eyebrow">{lfi.eyebrow}</span>
        <h2 class="lfi__title" set:html={lfi.title} />
        <p class="lfi__sub">{lfi.sub}</p>
      </div>
    )}

    <!-- Right: form panel -->
    <div class="lfi__panel" id="lfi-root">
      <LeadFormBody prefix="li" lang={lang} />
    </div>

  </div>
</section>

<style>
  .lfi {
    padding: 7vh var(--pad-x) 8vh;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .lfi__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(3rem, 6vw, 8rem);
    align-items: start;
  }

  .lfi__intro {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .lfi__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.95;
    margin: 0;
  }
  .lfi__title em { color: var(--color-accent); font-style: normal; }

  .lfi__sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.05vw, 18px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text-light);
    max-width: 44ch;
    margin: 0;
  }

  /* Panel form */
  .lfi__panel {
    background: var(--lm-bg);
    color: var(--lm-text);
    border: 1px solid var(--lm-border);
    display: flex;
    flex-direction: column;
  }

  /* Override step bar styling for inline context */
  .lfi__panel :global(.lm__steps) {
    background: var(--lm-bg-head);
    border-bottom: 1px solid var(--lm-border);
    border-top: 1px solid var(--lm-border);
  }

  @media (max-width: 900px) {
    .lfi__inner {
      grid-template-columns: 1fr;
    }
    .lfi__intro {
      position: static;
    }
    .lfi__sub { max-width: 100%; }
  }

  /* ── Standalone: solo il form, a schermo intero (es. landing da QR code) ── */
  .lfi--standalone {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 4vh var(--pad-x);
    border-top: none;
  }

  .lfi--standalone .lfi__inner {
    grid-template-columns: 1fr;
    max-width: 620px;
    width: 100%;
    margin: 0 auto;
  }

  @media (max-width: 560px) {
    .lfi--standalone {
      padding: 3vh 16px;
    }
  }
</style>

<script>
  // @ts-nocheck — vanilla browser script (DOM access, no type annotations)
  import { initLeadForm } from '../lib/leadForm.client.js';

  var root = document.getElementById('lfi-root');
  if (root) {
    var form = initLeadForm(root, { prefix: 'li' });
    form.open(location.pathname, 'Form inline');
  }
</script>
