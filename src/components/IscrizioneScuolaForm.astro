---
import type { Lang } from '../i18n/utils';
import prefissi from '../data/prefissi-telefonici';
import { getEntry } from 'astro:content';

interface Props { lang?: Lang; backHref?: string; }
const { lang = 'it', backHref = '/scuola-tennis' } = Astro.props;

const PREP_SLOTS = ['14:30','15:30','16:30','17:30','18:30'];

// Scadenze, acconto e fasce d'età gestibili da TinaCMS → src/content/moduli/dati-stagionali.md
const d = (await getEntry('moduli', 'dati-stagionali'))!.data;

const t = lang === 'en' ? {
  intro: `This is a <strong>registration to take the trial</strong>, not a course enrolment. The trial is a brief introductory lesson with our coaches, without appointment, to assess your level and build homogeneous groups: your place on the course will be confirmed exclusively by our coaches at the end of the trial. The trial cannot be booked for a specific time slot — it is open on the days and within the time windows indicated below.`,
  introTrials: `Trials: from ${d.scuola_prove_periodo1_en}, 15.00–18.30, open to everyone, no appointment needed.`,

  minorTitle: "Minor's details",
  minorSub: 'Enter the details of the child/teenager to be enrolled.',
  minorFirst: "Child's first name",
  minorLast: "Child's last name",
  minorDob: 'Date of birth',
  minorPob: 'Place of birth',
  minorCf: 'Fiscal code',
  minorCfNote: 'If you have trouble entering it, contact the Club at tennis-academy@tcambrosiano.com',
  addr: 'Address',
  addrPh: 'Via Feltre 33',
  city: 'City',
  cityPh: 'Milano',
  prov: 'Province',
  provPh: 'MI',
  cap: 'Postcode',

  parentTitle: "Parent's details",
  parentFirst: "Parent's first name",
  parentLast: "Parent's last name",
  parentDob: 'Date of birth',
  email: 'Email',
  emailNote: "Make sure the email address is correct: you'll receive all communications from the Club there.",
  mobile: 'Mobile',

  detailsTitle: 'Enrolment details',
  miniLabel: 'Mini-Tennis School',
  miniAge: `(born in ${d.scuola_mini_tennis_nati_en})`,
  miniDesc: '60-minute lessons, tennis only. Frequency: 1 or 2 times a week.',
  tennisLabel: 'Tennis School',
  tennisAge: `(born in ${d.scuola_tennis_nati_en})`,
  tennisDesc: '60 minutes of tennis + 30 minutes of athletics. Frequency: 1, 2 or 3 times a week.',
  warnSaldo: 'The course fee is paid in a single instalment at reception, when you enrol for the course — once your place has been confirmed by our coaches after the trial.',
  warnFitp: 'Please note that a valid FITP membership card is required (the fee is needed to complete enrolment). A valid medical certificate must also be provided.',

  courseType: 'Course type',
  courseTypePh: 'Select a course type…',
  frequency: 'Frequency',
  miniMono: 'Mini-Tennis once a week',
  miniBi: 'Mini-Tennis twice a week',
  tennisMono: 'Tennis once a week',
  tennisBi: 'Tennis twice a week',
  tennisTri: 'Tennis three times a week',
  days: 'Day preference',
  dayNames: ['Monday','Tuesday','Wednesday','Thursday','Friday'],
  timePrefs: 'Tennis School time preference',
  buddy: 'Preferred tennis partner',
  athleticTitle: 'Athletic Training',
  athleticSlot: 'Athletic training time slot (not offered for Mini-Tennis) — see table',
  athleticSlotPh: 'Select a time…',
  athleticNote: 'Not offered for the Mini-Tennis School.',
  athleticTablePick: 'Chosen slot',
  athleticTableTime: 'Athletic training time',
  athleticRows: [
    ['14:30 – 15:30','14:00 – 14:30 (30 min before)'],
    ['15:30 – 16:30','15:00 – 15:30 (before) or 16:30 – 17:00 (after)'],
    ['16:30 – 17:30','16:00 – 16:30 (30 min before)'],
    ['17:30 – 18:30','17:00 – 17:30 (30 min before)'],
    ['18:30 – 19:30','18:00 – 18:30 (30 min before)'],
  ],

  termsTitle: 'Terms & Conditions',
  termsList: [
    'this is a registration to take part in the trial, not a course enrolment: your place and level will be confirmed exclusively by our coaches after the trial;',
    'the trial cannot be booked for a specific time slot: simply come along on the days and within the time windows indicated;',
    'the course fee is paid in a single instalment at reception, once your place on the course has been confirmed;',
    'withdrawal from the courses during the year, for any reason, does not give the right to any refund, not even partial;',
    'it is mandatory to submit the medical certificate of fitness for sports activity before the course begins;',
    'FITP (Italian Tennis and Padel Federation) membership is mandatory.',
  ],
  acceptTerms: 'I have read and accept the Terms & Conditions.',
  acceptRules: 'I have read and accept the {link} of the Tennis School.',
  acceptRulesLink: 'rules',
  acceptPrivacy: 'I have read and accept your {link}.',
  acceptPrivacyLink: 'Privacy Policy',

  back: '← Back',
  next: 'Next',
  submit: 'Book the trial',
  backToPage: 'Back to the Tennis School page',

  confirmTitle: 'Thank<br><em>you!</em>',
  confirmNote: "Thank you for registering. We look forward to seeing you at the trial, on the days and within the time windows indicated — no need to book a specific time.",
  confirmNextSteps: "Your place on the course will be confirmed by our coaches after the trial. Once confirmed, you can complete your enrolment and pay the full fee in a single instalment directly at reception.",

  errRequired: 'Please fill in this required field.',
  errEmail: 'Please enter a valid email address.',
  errChoice: 'Please make a choice.',
  errCheck: 'Please select at least one option.',
  errConsent: 'This consent is required.',
} : {
  intro: `Questa è una <strong>registrazione per effettuare il provino</strong>, non un'iscrizione al corso. Il provino è una breve lezione conoscitiva con i nostri maestri, senza appuntamento, per valutare il livello e creare gruppi omogenei: la partecipazione al corso sarà confermata esclusivamente dai maestri al termine del provino. Il provino non è prenotabile per un orario specifico: è aperto nei giorni e nelle fasce orarie indicate qui sotto.`,
  introTrials: `Provini: dal ${d.scuola_prove_periodo1}, ore 15.00–18.30, aperti a tutti gli interessati, senza appuntamento.`,

  minorTitle: 'Dati del minore',
  minorSub: 'Inserisci di seguito i dati del bambino/ragazzo da iscrivere.',
  minorFirst: 'Nome del minore',
  minorLast: 'Cognome del minore',
  minorDob: 'Data di nascita',
  minorPob: 'Luogo di nascita',
  minorCf: 'Codice fiscale',
  minorCfNote: "In caso di problemi con l'inserimento, contattare il Club all'indirizzo tennis-academy@tcambrosiano.com",
  addr: 'Indirizzo',
  addrPh: 'Via Feltre 33',
  city: 'Città',
  cityPh: 'Milano',
  prov: 'Provincia',
  provPh: 'MI',
  cap: 'Codice postale',

  parentTitle: 'Dati del genitore',
  parentFirst: 'Nome del genitore',
  parentLast: 'Cognome del genitore',
  parentDob: 'Data di nascita',
  email: 'Email',
  emailNote: "Controlla bene di aver inserito un indirizzo email corretto: lì riceverai tutte le comunicazioni da parte del Club.",
  mobile: 'Cellulare',

  detailsTitle: 'Dettagli iscrizione',
  miniLabel: 'Scuola mini-tennis',
  miniAge: `(nati nel ${d.scuola_mini_tennis_nati})`,
  miniDesc: 'Lezioni di 60 minuti, solo tennis. Frequenza: 1 o 2 volte a settimana.',
  tennisLabel: 'Scuola tennis',
  tennisAge: `(nati nel ${d.scuola_tennis_nati})`,
  tennisDesc: 'Lezioni di 60 minuti di tennis + 30 minuti di atletica. Frequenza: 1, 2 o 3 volte a settimana.',
  warnSaldo: "Il pagamento della quota andrà effettuato in un'unica soluzione in segreteria, al momento dell'iscrizione al corso — una volta confermata la partecipazione dai maestri dopo il provino.",
  warnFitp: "Si prega di notare che è richiesto il possesso della tessera FITP (in corso di validità), la cui quota è necessaria per completare l'iscrizione. Inoltre, è obbligatorio presentare un certificato medico in corso di validità.",

  courseType: 'Tipo di corso',
  courseTypePh: 'Seleziona un tipo di corso…',
  frequency: 'Frequenza',
  miniMono: 'Mini-tennis mono settimanale',
  miniBi: 'Mini-tennis bisettimanale',
  tennisMono: 'Tennis mono settimanale',
  tennisBi: 'Tennis bisettimanale',
  tennisTri: 'Tennis trisettimanale',
  days: 'Preferenza giorni',
  dayNames: ['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì'],
  timePrefs: 'Preferenza orari scuola tennis',
  buddy: 'Compagno di tennis preferito',
  athleticTitle: 'Preparazione Fisica',
  athleticSlot: 'Scelta orario per preparazione fisica SCUOLA TENNIS (non prevista per Mini Tennis) — vedi tabella',
  athleticSlotPh: 'Seleziona un orario…',
  athleticNote: 'Non prevista per la Scuola Mini-Tennis.',
  athleticTablePick: 'Scelta slot orario',
  athleticTableTime: 'Orario preparazione fisica',
  athleticRows: [
    ['14:30 – 15:30','14:00 – 14:30 (30 min prima)'],
    ['15:30 – 16:30','15:00 – 15:30 (prima) oppure 16:30 – 17:00 (dopo)'],
    ['16:30 – 17:30','16:00 – 16:30 (30 min prima)'],
    ['17:30 – 18:30','17:00 – 17:30 (30 min prima)'],
    ['18:30 – 19:30','18:00 – 18:30 (30 min prima)'],
  ],

  termsTitle: 'Termini e condizioni',
  termsList: [
    'la presente è una registrazione per partecipare al provino, non un’iscrizione al corso: il tuo posto e il livello verranno confermati esclusivamente dai maestri dopo il provino;',
    'il provino non è prenotabile per un orario specifico: è sufficiente presentarsi nei giorni e nelle fasce orarie indicate;',
    'il pagamento della quota andrà effettuato in un’unica soluzione in segreteria, al momento dell’iscrizione, una volta confermata la partecipazione al corso;',
    'l’eventuale ritiro dai corsi durante l’anno, per qualsiasi motivo, non dà diritto ad alcun rimborso, neppure parziale;',
    'si ricorda che è obbligatorio consegnare il certificato medico di idoneità all’attività sportiva prima dell’inizio del corso;',
    'è obbligatorio effettuare il tesseramento alla FITP (Federazione Italiana Tennis e Padel).',
  ],
  acceptTerms: 'Ho letto e accetto i Termini e Condizioni.',
  acceptRules: 'Ho letto e accetto il {link} della Scuola Tennis.',
  acceptRulesLink: 'regolamento',
  acceptPrivacy: 'Ho letto e accetto la vostra {link}.',
  acceptPrivacyLink: 'Privacy Policy',

  back: '← Indietro',
  next: 'Avanti',
  submit: 'Prenota il provino',
  backToPage: 'Torna alla pagina Scuola Tennis',

  confirmTitle: 'Grazie!',
  confirmNote: 'Grazie per la registrazione. Ti aspettiamo al provino, nei giorni e nelle fasce orarie indicate — non serve prenotare un orario specifico.',
  confirmNextSteps: 'La partecipazione al corso sarà confermata dai nostri maestri dopo il provino. Una volta confermato il tuo inserimento, potrai completare l’iscrizione e il pagamento in un’unica soluzione direttamente in segreteria.',

  errRequired: 'Compila questo campo obbligatorio.',
  errEmail: 'Inserisci un indirizzo email valido.',
  errChoice: 'Effettua una scelta.',
  errCheck: 'Seleziona almeno un’opzione.',
  errConsent: 'Questo consenso è obbligatorio.',
};
---

<div class="isc-form" id="isc-form-root">

  <!-- STEP 1 — Dati minore + genitore -->
  <div class="lm__body" data-isc-step="1">
    <div class="lm__notice">
      <p set:html={t.intro} />
      <p>{t.introTrials}</p>
    </div>

    <p class="lm__section-title lm__section-title--first">{t.minorTitle}</p>
    <p class="lm__sub">{t.minorSub}</p>

    <div class="lm__grid">
      <div class="lm__field">
        <label for="isc-minor-nome">{t.minorFirst} <span aria-hidden="true">*</span></label>
        <input id="isc-minor-nome" type="text" required />
      </div>
      <div class="lm__field">
        <label for="isc-minor-cognome">{t.minorLast} <span aria-hidden="true">*</span></label>
        <input id="isc-minor-cognome" type="text" required />
      </div>
      <div class="lm__field">
        <label for="isc-minor-dob">{t.minorDob} <span aria-hidden="true">*</span></label>
        <input id="isc-minor-dob" type="date" required />
      </div>
      <div class="lm__field">
        <label for="isc-minor-pob">{t.minorPob} <span aria-hidden="true">*</span></label>
        <input id="isc-minor-pob" type="text" required />
      </div>
      <div class="lm__field lm__field--full">
        <label for="isc-minor-cf">{t.minorCf} <span aria-hidden="true">*</span></label>
        <input id="isc-minor-cf" type="text" maxlength="16" class="lm__input--cf" required />
      </div>
    </div>
    <p class="lm__hint">{t.minorCfNote}</p>

    <div class="lm__grid">
      <div class="lm__field lm__field--full">
        <label for="isc-addr">{t.addr} <span aria-hidden="true">*</span></label>
        <input id="isc-addr" type="text" placeholder={t.addrPh} required />
      </div>
      <div class="lm__field">
        <label for="isc-city">{t.city} <span aria-hidden="true">*</span></label>
        <input id="isc-city" type="text" placeholder={t.cityPh} required />
      </div>
      <div class="lm__field">
        <label for="isc-prov">{t.prov} <span aria-hidden="true">*</span></label>
        <input id="isc-prov" type="text" maxlength="2" placeholder={t.provPh} required />
      </div>
      <div class="lm__field lm__field--full">
        <label for="isc-cap">{t.cap} <span aria-hidden="true">*</span></label>
        <input id="isc-cap" type="text" inputmode="numeric" required />
      </div>
    </div>

    <p class="lm__section-title">{t.parentTitle}</p>
    <div class="lm__grid">
      <div class="lm__field">
        <label for="isc-parent-nome">{t.parentFirst} <span aria-hidden="true">*</span></label>
        <input id="isc-parent-nome" type="text" autocomplete="given-name" required />
      </div>
      <div class="lm__field">
        <label for="isc-parent-cognome">{t.parentLast} <span aria-hidden="true">*</span></label>
        <input id="isc-parent-cognome" type="text" autocomplete="family-name" required />
      </div>
      <div class="lm__field">
        <label for="isc-parent-dob">{t.parentDob} <span aria-hidden="true">*</span></label>
        <input id="isc-parent-dob" type="date" autocomplete="bday" required />
      </div>
      <div class="lm__field lm__field--full">
        <label for="isc-email">{t.email} <span aria-hidden="true">*</span></label>
        <input id="isc-email" type="email" autocomplete="email" placeholder="nome@esempio.com" required />
      </div>
    </div>
    <p class="lm__hint">{t.emailNote}</p>
    <div class="lm__grid">
      <div class="lm__field lm__field--full">
        <label for="isc-cell">{t.mobile} <span aria-hidden="true">*</span></label>
        <div class="lm__tel-wrap">
          <select id="isc-pfx" class="lm__tel-prefix" autocomplete="tel-country-code">
            {prefissi.map((pf) => (
              <option value={pf.dial} selected={pf.dial === '+39'}>{pf.flag} {pf.dial}</option>
            ))}
          </select>
          <input id="isc-cell" type="tel" autocomplete="tel-national" placeholder="3XX XXX XXXX" required />
        </div>
      </div>
    </div>

    <p class="lm__error" hidden role="alert"></p>
    <div class="lm__actions">
      <button type="button" class="btn btn-red lm__next" data-isc-next="1">
        {t.next} <span class="lm__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <!-- STEP 2 — Dettagli iscrizione -->
  <div class="lm__body" data-isc-step="2" hidden>
    <p class="lm__section-title lm__section-title--first">{t.detailsTitle}</p>
    <div class="lm__notice">
      <p><strong>{t.miniLabel}</strong> {t.miniAge}<br />{t.miniDesc}</p>
      <p><strong>{t.tennisLabel}</strong> {t.tennisAge}<br />{t.tennisDesc}</p>
    </div>
    <p class="lm__notice-warn">{t.warnSaldo}</p>
    <p class="lm__notice-warn">{t.warnFitp}</p>

    <div class="lm__field">
      <label for="isc-tipo">{t.courseType} <span aria-hidden="true">*</span></label>
      <select id="isc-tipo" required>
        <option value="" selected disabled>{t.courseTypePh}</option>
        <option value="mini">{t.miniLabel}</option>
        <option value="tennis">{t.tennisLabel}</option>
      </select>
    </div>

    <div data-isc-tipo-group="mini" hidden>
      <p class="lm__label-group">{t.frequency} <span aria-hidden="true">*</span></p>
      <div class="lm__checks">
        <label class="lm__check-item"><input type="radio" name="isc-freq-mini" value="mono" /> <span>{t.miniMono}</span></label>
        <label class="lm__check-item"><input type="radio" name="isc-freq-mini" value="bi" /> <span>{t.miniBi}</span></label>
      </div>
      <p class="lm__label-group">{t.days} <span aria-hidden="true">*</span></p>
      <div class="lm__checks">
        {t.dayNames.map((d) => (
          <label class="lm__check-item"><input type="checkbox" name="isc-giorni-mini" value={d} /> <span>{d} 17.30</span></label>
        ))}
      </div>
    </div>

    <div data-isc-tipo-group="tennis" hidden>
      <p class="lm__label-group">{t.frequency} <span aria-hidden="true">*</span></p>
      <div class="lm__checks">
        <label class="lm__check-item"><input type="radio" name="isc-freq-tennis" value="mono" /> <span>{t.tennisMono}</span></label>
        <label class="lm__check-item"><input type="radio" name="isc-freq-tennis" value="bi" /> <span>{t.tennisBi}</span></label>
        <label class="lm__check-item"><input type="radio" name="isc-freq-tennis" value="tri" /> <span>{t.tennisTri}</span></label>
      </div>
      <p class="lm__label-group">{t.days} <span aria-hidden="true">*</span></p>
      <div class="lm__checks">
        {t.dayNames.map((d) => (
          <label class="lm__check-item"><input type="checkbox" name="isc-giorni-tennis" value={d} /> <span>{d}</span></label>
        ))}
      </div>
      <p class="lm__label-group">{t.timePrefs} <span aria-hidden="true">*</span></p>
      <div class="lm__checks">
        {PREP_SLOTS.map((s) => (
          <label class="lm__check-item"><input type="checkbox" name="isc-orari-tennis" value={s} /> <span>{s.replace(':', '.')}</span></label>
        ))}
      </div>
    </div>

    <div class="lm__field">
      <label for="isc-buddy">{t.buddy}</label>
      <input id="isc-buddy" type="text" />
    </div>

    <p class="lm__section-title">{t.athleticTitle}</p>
    <div data-isc-tipo-group="tennis" hidden>
      <div class="lm__field">
        <label for="isc-prep-orario">{t.athleticSlot} <span aria-hidden="true">*</span></label>
        <select id="isc-prep-orario">
          <option value="" selected disabled>{t.athleticSlotPh}</option>
          {PREP_SLOTS.map((s) => <option value={s}>{s}</option>)}
        </select>
      </div>
      <div class="lm__table-wrap">
        <table class="lm__table">
          <thead><tr><th>{t.athleticTablePick}</th><th>{t.athleticTableTime}</th></tr></thead>
          <tbody>
            {t.athleticRows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
    <p class="lm__hint" data-isc-tipo-group="mini" hidden>{t.athleticNote}</p>

    <p class="lm__error" hidden role="alert"></p>
    <div class="lm__actions">
      <button type="button" class="lm__back" data-isc-back="1">{t.back}</button>
      <button type="button" class="btn btn-red lm__next" data-isc-next="2">
        {t.next} <span class="lm__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <!-- STEP 3 — Termini e condizioni -->
  <div class="lm__body" data-isc-step="3" hidden>
    <p class="lm__section-title lm__section-title--first">{t.termsTitle}</p>
    <ul class="lm__terms-list">
      {t.termsList.map((item) => <li>{item}</li>)}
    </ul>

    <div class="lm__consent">
      <label class="lm__consent-item">
        <input type="checkbox" id="isc-accept-terms" required />
        <span>{t.acceptTerms}</span>
      </label>
      <label class="lm__consent-item">
        <input type="checkbox" id="isc-accept-rules" required />
        <span set:html={t.acceptRules.replace('{link}', `<a href="/regolamento" target="_blank">${t.acceptRulesLink}</a>`)} />
      </label>
      <label class="lm__consent-item">
        <input type="checkbox" id="isc-accept-privacy" required />
        <span set:html={t.acceptPrivacy.replace('{link}', `<a href="/privacy-policy" target="_blank">${t.acceptPrivacyLink}</a>`)} />
      </label>
    </div>

    <p class="lm__error" hidden role="alert"></p>
    <div class="lm__actions">
      <button type="button" class="lm__back" data-isc-back-dynamic>{t.back}</button>
      <button type="button" class="btn btn-red lm__next" id="isc-submit">
        {t.submit} <span class="lm__arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <!-- CONFERMA -->
  <div class="lm__body lm__confirm" data-isc-step="confirm" hidden aria-live="polite">
    <div class="lm__confirm-check" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
        <path d="M4 13L10 19L22 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <h3 class="lm__confirm-title" set:html={t.confirmTitle} />
    <p class="lm__confirm-note">{t.confirmNote}</p>
    <p class="lm__confirm-note">{t.confirmNextSteps}</p>
    <a class="btn btn-red lm__confirm-cta" href={backHref}>{t.backToPage}</a>
  </div>

</div>

<style>
  .isc-form {
    background: var(--lm-bg);
    color: var(--lm-text);
    border: 1px solid var(--lm-border);
  }
</style>

<style is:global>
  /* ── Select coerenti con input/textarea del sistema .lm ───────────
     Selettore ristretto ai figli diretti di .lm__field: il select del
     prefisso telefonico (dentro .lm__tel-wrap) ha le sue regole dedicate
     e non deve ereditare width:100%. ───────────────────────────────── */
  .lm__field > select {
    font-family: var(--font-body); font-size: clamp(13px,.95vw,15px);
    font-weight: 300; padding: 0.7rem 2rem 0.7rem 0.85rem;
    border: 1px solid var(--lm-input-bd);
    background: var(--lm-input-bg); color: var(--lm-text);
    width: 100%; transition: border-color 0.18s;
    -webkit-appearance: none; appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%236B5C57' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right 14px center;
  }
  .lm__field > select:invalid { color: var(--lm-text-dim); }
  .lm__field > select:focus { outline: none; border-color: var(--color-accent); background-color: #fff; }

  .lm__check-item input[type="radio"] { accent-color: var(--color-accent); flex-shrink: 0; }

  .lm__input--cf { text-transform: uppercase; }

  /* ── Titoli di sotto-sezione dentro uno step ─────────────────────── */
  .lm__section-title {
    font-family: var(--font-display); font-size: clamp(1rem,1.6vw,1.25rem);
    font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em;
    color: var(--lm-text); margin: 0.6rem 0 0;
    padding-top: 1rem; border-top: 1px solid var(--lm-border);
  }
  .lm__section-title--first { padding-top: 0; border-top: none; margin-top: 0; }

  .lm__hint {
    font-family: var(--font-body); font-size: clamp(11px,.8vw,12px);
    font-weight: 300; color: var(--lm-text-dim); margin: -0.6rem 0 0;
  }

  .lm__sub a { color: var(--color-accent); text-decoration: underline; }
  .lm__sub a:hover { color: var(--color-accent-dark); }

  /* ── Box informativo (date, quote di riferimento) ────────────────── */
  .lm__notice {
    background: var(--lm-input-bg); border: 1px solid var(--lm-border);
    border-left: 3px solid var(--color-accent);
    padding: 1rem 1.2rem; display: flex; flex-direction: column; gap: 0.6rem;
  }
  .lm__notice p {
    font-family: var(--font-body); font-size: clamp(12px,.9vw,13px);
    font-weight: 300; line-height: 1.6; color: var(--lm-text-sub); margin: 0;
  }
  .lm__notice p strong { color: var(--lm-text); font-weight: 700; }

  .lm__notice-warn {
    font-family: var(--font-body); font-size: clamp(12px,.9vw,13px);
    font-weight: 400; line-height: 1.6; color: var(--color-accent); margin: 0;
  }

  /* ── Elenco termini e condizioni ──────────────────────────────────── */
  .lm__terms-list {
    margin: 0; padding-left: 1.1rem;
    display: flex; flex-direction: column; gap: 0.5rem;
    font-family: var(--font-body); font-size: clamp(12px,.9vw,13px);
    font-weight: 300; line-height: 1.6; color: var(--lm-text-sub);
  }

  /* ── Tabella slot preparazione fisica ─────────────────────────────── */
  .lm__table-wrap { overflow-x: auto; border: 1px solid var(--lm-border); }
  .lm__table { width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: clamp(11px,.85vw,12.5px); }
  .lm__table th, .lm__table td { padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--lm-border); text-align: left; }
  .lm__table th { font-weight: 700; color: var(--lm-text); background: var(--lm-bg-head); white-space: nowrap; }
  .lm__table td { font-weight: 300; color: var(--lm-text-sub); }
  .lm__table tr:last-child td { border-bottom: none; }

</style>

<script define:vars={{ ERR: {
  required: t.errRequired,
  email: t.errEmail,
  choice: t.errChoice,
  check: t.errCheck,
  consent: t.errConsent,
} }}>
  const root = document.getElementById('isc-form-root');

  const WEBHOOK_ISCRIZIONE = 'https://automazione.n8ndevelop.it/webhook/scuola-tennis-tca';

  // UTM/click-id e ID visitatore persistente (vedi BaseLayout.astro)
  function getUtm() {
    if (window.tcaGetUtm) return window.tcaGetUtm();
    try { return JSON.parse(sessionStorage.getItem('tca_utm') || '{}'); } catch (e) { return {}; }
  }
  function getVid() {
    return window.tcaGetVid ? window.tcaGetVid() : null;
  }

  function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()); }

  function showStep(key) {
    root.querySelectorAll('[data-isc-step]').forEach((el) => {
      el.hidden = el.dataset.iscStep !== String(key);
    });
    root.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function showError(step, msg) {
    const err = root.querySelector(`[data-isc-step="${step}"] > .lm__error`);
    if (err) { err.textContent = msg; err.hidden = false; }
  }
  function clearError(step) {
    const err = root.querySelector(`[data-isc-step="${step}"] > .lm__error`);
    if (err) err.hidden = true;
  }

  const tipoSelect = document.getElementById('isc-tipo');
  const prepSelect = document.getElementById('isc-prep-orario');

  function syncTipoGroups() {
    const tipo = tipoSelect.value;
    root.querySelectorAll('[data-isc-tipo-group]').forEach((el) => {
      el.hidden = el.dataset.iscTipoGroup !== tipo;
    });
  }
  tipoSelect.addEventListener('change', syncTipoGroups);

  root.querySelectorAll('[data-isc-back]').forEach((btn) => {
    btn.addEventListener('click', () => showStep(btn.dataset.iscBack));
  });

  // STEP 1 → 2
  root.querySelector('[data-isc-next="1"]').addEventListener('click', () => {
    clearError('1');
    const required = ['isc-minor-nome','isc-minor-cognome','isc-minor-dob','isc-minor-pob','isc-minor-cf',
                      'isc-addr','isc-city','isc-prov','isc-cap',
                      'isc-parent-nome','isc-parent-cognome','isc-parent-dob','isc-email','isc-cell'];
    for (const id of required) {
      const el = document.getElementById(id);
      if (!el.value.trim()) { showError('1', ERR.required); el.focus(); return; }
    }
    const emailEl = document.getElementById('isc-email');
    if (!isValidEmail(emailEl.value)) { showError('1', ERR.email); emailEl.focus(); return; }
    showStep('2');
  });

  // STEP 2 → 3 (o 4 se Mini Tennis)
  root.querySelector('[data-isc-next="2"]').addEventListener('click', () => {
    clearError('2');
    const tipo = tipoSelect.value;
    if (!tipo) { showError('2', ERR.choice); tipoSelect.focus(); return; }

    const freqChecked = root.querySelector(`input[name="isc-freq-${tipo}"]:checked`);
    if (!freqChecked) { showError('2', ERR.choice); return; }

    const giorniChecked = root.querySelectorAll(`input[name="isc-giorni-${tipo}"]:checked`);
    if (giorniChecked.length === 0) { showError('2', ERR.check); return; }

    if (tipo === 'tennis') {
      const orariChecked = root.querySelectorAll('input[name="isc-orari-tennis"]:checked');
      if (orariChecked.length === 0) { showError('2', ERR.check); return; }
      if (!prepSelect.value) { showError('2', ERR.choice); prepSelect.focus(); return; }
    }
    showStep('3');
  });

  // Indietro da step 3 (termini)
  root.querySelector('[data-isc-back-dynamic]').addEventListener('click', () => {
    showStep('2');
  });

  // Raccoglie tutti i campi compilati negli step 1-3 per l'invio finale
  function collectPayload() {
    const val = (id) => { const el = document.getElementById(id); return el ? el.value.trim() : ''; };
    const tipo = tipoSelect.value;
    const giorni = Array.from(root.querySelectorAll(`input[name="isc-giorni-${tipo}"]:checked`)).map((el) => el.value);
    const freqEl = root.querySelector(`input[name="isc-freq-${tipo}"]:checked`);

    const payload = {
      minore: {
        nome: val('isc-minor-nome'),
        cognome: val('isc-minor-cognome'),
        dataNascita: val('isc-minor-dob'),
        luogoNascita: val('isc-minor-pob'),
        codiceFiscale: val('isc-minor-cf'),
      },
      indirizzo: {
        via: val('isc-addr'),
        citta: val('isc-city'),
        provincia: val('isc-prov'),
        cap: val('isc-cap'),
      },
      genitore: {
        nome: val('isc-parent-nome'),
        cognome: val('isc-parent-cognome'),
        dataNascita: val('isc-parent-dob'),
        email: val('isc-email'),
        cellulare: `${document.getElementById('isc-pfx').value} ${val('isc-cell')}`,
      },
      iscrizione: {
        tipo,
        frequenza: freqEl ? freqEl.value : '',
        giorni,
        compagnoPreferito: val('isc-buddy'),
      },
      consensi: { termini: true, regolamento: true, privacy: true },
      pagina: location.href,
      referrer: document.referrer || null,
      utm: getUtm(),
      vid: getVid(),
    };

    if (tipo === 'tennis') {
      payload.iscrizione.orariPreferiti = Array.from(root.querySelectorAll('input[name="isc-orari-tennis"]:checked')).map((el) => el.value);
      payload.iscrizione.orarioPreparazione = prepSelect.value;
    }

    return payload;
  }

  // STEP 4 → invio + conferma
  const submitBtn = document.getElementById('isc-submit');
  submitBtn.addEventListener('click', async () => {
    clearError('4');
    const terms = document.getElementById('isc-accept-terms');
    const rules = document.getElementById('isc-accept-rules');
    const privacy = document.getElementById('isc-accept-privacy');
    if (!terms.checked || !rules.checked || !privacy.checked) { showError('4', ERR.consent); return; }

    submitBtn.disabled = true;
    try {
      await fetch(WEBHOOK_ISCRIZIONE, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(collectPayload()),
      });
    } catch (e) {}
    submitBtn.disabled = false;

    showStep('confirm');
  });
</script>
