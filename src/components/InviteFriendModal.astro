---
import type { Lang } from '../i18n/utils';
import prefissi from '../data/prefissi-telefonici';

interface Props { lang?: Lang; }
const { lang = 'it' } = Astro.props;

const t = lang === 'en' ? {
  eyebrow: 'Word of mouth',
  title: 'Invite a<br><em>Friend.</em>',
  closeLabel: 'Close',
  promoLead: 'Introduce a friend and get <strong>€30 credit</strong> on your membership when they join.',
  promoStepsTitle: 'How it works',
  promoSteps: [
    'Leave your details and your friend’s.',
    'Our team gets in touch to introduce them to the Club and the available options.',
    'If they take out a membership, you get €30 credit on your next fee.',
  ],
  promoPerks: ['No limit on invites', 'Always on, no end date'],
  promoDetailsLabel: 'Who you can invite and conditions',
  promoDetails: [
    'Friends or family who have had no active TC Ambrosiano membership from 2021 to today.',
    'If the new member withdraws within the first 14 days, the €30 credit is cancelled.',
  ],
  step1Sub: "Enter the email address you used to register on our app.",
  step1Label: 'Your email',
  step1Next: 'Continue',
  step2Sub: "Now your friend's details: we'll get in touch to introduce them to the Club.",
  friendName: "Friend's first name",
  friendSurname: "Friend's last name",
  friendEmail: "Friend's email",
  friendPhone: "Friend's mobile",
  disclaimer: 'I declare that I am authorised by my friend to share their personal data with TC Ambrosiano for the purposes of this request, and that I have informed them, pursuant to Art. 14 of Regulation (EU) 2016/679 (GDPR), about the processing of their personal data by the Club.',
  back: 'Back',
  send: 'Send invite',
  confirmTitle: 'Invite<br><em>sent!</em>',
  confirmNote: "Thank you! We'll be in touch with your friend soon to introduce them to TC Ambrosiano.",
  confirmClose: 'Close',
  errEmail: 'Please enter a valid email address.',
  errNome: "Please enter your friend's first name.",
  errCognome: "Please enter your friend's last name.",
  errFriendEmail: "Please enter your friend's email address.",
  errCell: "Please enter your friend's mobile number.",
  errConsent: 'You must confirm you are authorised to share this data.',
} : {
  eyebrow: 'Passaparola',
  title: 'Invita un<br><em>Amico.</em>',
  closeLabel: 'Chiudi',
  promoLead: 'Presenta un amico e ricevi <strong>30 € di credito</strong> sulla tua membership quando si iscrive.',
  promoStepsTitle: 'Come funziona',
  promoSteps: [
    'Lasci i tuoi dati e quelli della persona che vuoi invitare.',
    'Il nostro team la contatta per presentarle il Club e le formule disponibili.',
    'Se sottoscrive una membership, ricevi 30 € di credito sulla tua prossima quota.',
  ],
  promoPerks: ['Nessun limite di inviti', 'Sempre attiva, senza scadenza'],
  promoDetailsLabel: 'Chi puoi invitare e condizioni',
  promoDetails: [
    'Amici o familiari che non abbiano avuto un abbonamento attivo al TC Ambrosiano dal 2021 a oggi.',
    'Se il nuovo socio esercita il diritto di recesso entro i primi 14 giorni, il credito di 30 € viene annullato.',
  ],
  step1Sub: "Scrivi qui l'indirizzo email con il quale sei registrato alla nostra APP.",
  step1Label: 'Il tuo indirizzo email',
  step1Next: 'Continua',
  step2Sub: 'Ora i dati del tuo amico: lo contatteremo per presentargli il Club.',
  friendName: 'Nome amico',
  friendSurname: 'Cognome amico',
  friendEmail: 'Email amico',
  friendPhone: 'Cellulare amico',
  disclaimer: "Dichiaro di essere autorizzato dal mio amico a comunicare i suoi dati personali al TC Ambrosiano ai fini di questa richiesta, e di averlo informato, ai sensi dell'art. 14 del Regolamento (UE) 2016/679 (GDPR), in merito al trattamento dei suoi dati personali da parte del Club.",
  back: 'Indietro',
  send: "Invia l'invito",
  confirmTitle: 'Invito<br><em>inviato!</em>',
  confirmNote: 'Grazie! Contatteremo presto il tuo amico per presentargli il TC Ambrosiano.',
  confirmClose: 'Chiudi',
  errEmail: 'Inserisci un indirizzo email valido.',
  errNome: 'Inserisci il nome del tuo amico.',
  errCognome: 'Inserisci il cognome del tuo amico.',
  errFriendEmail: "Inserisci l'email del tuo amico.",
  errCell: 'Inserisci il numero di cellulare del tuo amico.',
  errConsent: 'Devi confermare di essere autorizzato a comunicare questi dati.',
};
---

<dialog id="modal-invita-amico" class="lm" aria-labelledby="ia-title">
  <div class="lm__panel">

    <div class="lm__head">
      <div>
        <span class="eyebrow lm__eyebrow">{t.eyebrow}</span>
        <h2 class="lm__title" id="ia-title" set:html={t.title} />
      </div>
      <button class="lm__close" aria-label={t.closeLabel} data-ia-close>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="lm__steps">
      <span class="lm__step" data-ia-dot="1">1</span>
      <span class="lm__step-line"></span>
      <span class="lm__step" data-ia-dot="2">2</span>
    </div>

    <!-- STEP 1 — la tua email -->
    <div class="lm__body" data-ia-step="1">
      <!-- Promo: il vantaggio e il meccanismo restano sempre visibili, requisiti e
           nota sul recesso in un blocco richiudibile — trasparenti senza pesare
           sul form, che resta l'azione principale. -->
      <div class="ia-promo">
        <p class="ia-promo__lead" set:html={t.promoLead} />

        <p class="ia-promo__steps-title">{t.promoStepsTitle}</p>
        <ol class="ia-promo__steps">
          {t.promoSteps.map((s) => <li>{s}</li>)}
        </ol>

        <ul class="ia-promo__perks">
          {t.promoPerks.map((p) => <li>{p}</li>)}
        </ul>

        <details class="ia-promo__details">
          <summary>{t.promoDetailsLabel}</summary>
          <ul>
            {t.promoDetails.map((d) => <li>{d}</li>)}
          </ul>
        </details>
      </div>

      <p class="lm__sub">{t.step1Sub}</p>
      <div class="lm__field">
        <label for="ia-email">{t.step1Label} <span aria-hidden="true">*</span></label>
        <input id="ia-email" type="email" autocomplete="email" placeholder="nome@esempio.com" required />
      </div>
      <p class="lm__error" hidden></p>
      <div class="lm__actions">
        <button type="button" class="btn btn-red lm__next" id="ia-step1-next">
          {t.step1Next} <span class="lm__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- STEP 2 — dati dell'amico -->
    <div class="lm__body" data-ia-step="2" hidden>
      <p class="lm__sub">{t.step2Sub}</p>
      <div class="lm__grid">
        <div class="lm__field">
          <label for="ia-friend-nome">{t.friendName} <span aria-hidden="true">*</span></label>
          <input id="ia-friend-nome" type="text" autocomplete="off" required />
        </div>
        <div class="lm__field">
          <label for="ia-friend-cognome">{t.friendSurname} <span aria-hidden="true">*</span></label>
          <input id="ia-friend-cognome" type="text" autocomplete="off" required />
        </div>
        <div class="lm__field">
          <label for="ia-friend-email">{t.friendEmail} <span aria-hidden="true">*</span></label>
          <input id="ia-friend-email" type="email" autocomplete="off" placeholder="nome@esempio.com" required />
        </div>
        <div class="lm__field">
          <label for="ia-friend-cell">{t.friendPhone} <span aria-hidden="true">*</span></label>
          <div class="lm__tel-wrap">
            <select id="ia-friend-pfx" name="prefisso" class="lm__tel-prefix" autocomplete="tel-country-code">
              {prefissi.map((pf) => (
                <option value={pf.dial} selected={pf.dial === '+39'}>{pf.flag} {pf.dial}</option>
              ))}
            </select>
            <input id="ia-friend-cell" name="cellulare" type="tel" autocomplete="tel-national"
                   placeholder="3XX XXX XXXX" required />
          </div>
        </div>
      </div>

      <div class="lm__consent">
        <label class="lm__consent-item">
          <input type="checkbox" id="ia-consent" required />
          <span>{t.disclaimer}</span>
        </label>
      </div>

      <p class="lm__error" hidden></p>
      <div class="lm__actions">
        <button type="button" class="lm__back" data-ia-back="1">← {t.back}</button>
        <button type="button" class="btn btn-red lm__next" id="ia-step2-send">
          {t.send} <span class="lm__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- STEP 3 — conferma -->
    <div class="lm__body lm__confirm" data-ia-step="3" hidden>
      <div class="lm__confirm-check">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12.5l5 5L20 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="lm__confirm-title" set:html={t.confirmTitle} />
      <p class="lm__confirm-note">{t.confirmNote}</p>
      <button type="button" class="btn btn-red lm__confirm-cta" data-ia-close>{t.confirmClose}</button>
    </div>

  </div>
</dialog>

<style>
  /* ── Blocco promo (step 1) ──────────────────────────────────────────────
     Usa i token del modal lead (--lm-*), definiti globalmente in LeadModal. */
  .ia-promo {
    background: var(--lm-input-bg);
    border-left: 3px solid var(--color-accent);
    padding: 1.1rem 1.2rem;
    margin-bottom: 1.5rem;
  }

  .ia-promo__lead {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.1vw, 15.5px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--lm-text);
    margin: 0;
  }

  /* Il <strong> arriva da set:html, quindi senza attributo di scope Astro:
     va raggiunto con :global(). */
  .ia-promo__lead :global(strong) {
    font-weight: 600;
    color: var(--color-accent);
  }

  .ia-promo__steps-title {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lm-text-sub);
    margin: 1.1rem 0 0.5rem;
  }

  .ia-promo__steps {
    list-style: none;
    counter-reset: ia-step;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ia-promo__steps li {
    counter-increment: ia-step;
    position: relative;
    padding-left: 1.75rem;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.45;
    color: var(--lm-text-sub);
  }

  .ia-promo__steps li::before {
    content: counter(ia-step);
    position: absolute;
    left: 0;
    top: 0.05em;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Rassicurazioni brevi: spingono a compilare senza aggiungere testo lungo */
  .ia-promo__perks {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
  }

  .ia-promo__perks li {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    color: var(--lm-text);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .ia-promo__perks li::before {
    content: '✓';
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 700;
  }

  /* Requisiti e nota sul recesso: disponibili ma non invadenti */
  .ia-promo__details {
    margin-top: 1rem;
    border-top: 1px solid var(--lm-border);
    padding-top: 0.75rem;
  }

  .ia-promo__details summary {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    color: var(--lm-text-sub);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.18s;
  }

  .ia-promo__details summary::-webkit-details-marker { display: none; }

  .ia-promo__details summary::after {
    content: '+';
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    text-decoration: none;
    color: var(--color-accent);
  }

  .ia-promo__details[open] summary::after { content: '−'; }

  .ia-promo__details summary:hover { color: var(--lm-text); }

  .ia-promo__details summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .ia-promo__details ul {
    margin: 0.7rem 0 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ia-promo__details li {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--lm-text-sub);
  }

  @media (max-width: 600px) {
    .ia-promo { padding: 1rem; }
    .ia-promo__perks { gap: 0.35rem 0.8rem; }
  }
</style>

<script define:vars={{ ERR: {
  email: t.errEmail,
  nome: t.errNome,
  cognome: t.errCognome,
  friendEmail: t.errFriendEmail,
  cell: t.errCell,
  consent: t.errConsent,
} }}>
  const modal = document.getElementById('modal-invita-amico');
  const dots = modal.querySelectorAll('[data-ia-dot]');

  const WEBHOOK_REFERRAL = 'https://automazione.n8ndevelop.it/webhook/referral-tca';

  // UTM/click-id e ID visitatore persistente (vedi BaseLayout.astro)
  function getUtm() {
    if (window.tcaGetUtm) return window.tcaGetUtm();
    try { return JSON.parse(sessionStorage.getItem('tca_utm') || '{}'); } catch (e) { return {}; }
  }
  function getVid() {
    return window.tcaGetVid ? window.tcaGetVid() : null;
  }

  // Pagina e CTA da cui è stato aperto il modal (catturati all'apertura)
  let openPagina = location.pathname;
  let openCta = '';

  function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()); }

  function showStep(n) {
    modal.querySelectorAll('[data-ia-step]').forEach((el) => {
      el.hidden = el.dataset.iaStep !== String(n);
    });
    const isMain = n === 1 || n === 2;
    modal.querySelector('.lm__steps').hidden = !isMain;
    dots.forEach((dot) => {
      const d = parseInt(dot.dataset.iaDot, 10);
      dot.classList.toggle('is-active', d === n);
      dot.classList.toggle('is-done', d < n);
    });
  }

  function showError(step, msg) {
    const err = modal.querySelector(`[data-ia-step="${step}"] .lm__error`);
    if (err) { err.textContent = msg; err.hidden = false; }
  }

  function clearError(step) {
    const err = modal.querySelector(`[data-ia-step="${step}"] .lm__error`);
    if (err) err.hidden = true;
  }

  function resetForm() {
    modal.querySelectorAll('input[type="email"], input[type="text"], input[type="tel"]').forEach((el) => { el.value = ''; el.classList.remove('lm__input--error'); });
    modal.querySelectorAll('input[type="checkbox"]').forEach((el) => { el.checked = false; });
    showStep(1);
  }

  function closeAndReset() {
    modal.close();
    resetForm();
  }

  // Apertura tramite data-open-modal="modal-invita-amico"
  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-open-modal]');
    if (t && t.dataset.openModal === 'modal-invita-amico') {
      openPagina = location.pathname;
      openCta = (t.textContent || '').trim();
      modal.showModal();
      showStep(1);
    }
  });

  modal.addEventListener('click', (e) => {
    if (e.target.closest('[data-ia-close]') || e.target === modal) closeAndReset();
  });

  modal.querySelectorAll('[data-ia-back]').forEach((btn) => {
    btn.addEventListener('click', () => showStep(parseInt(btn.dataset.iaBack, 10)));
  });

  // STEP 1
  const emailInput = document.getElementById('ia-email');
  document.getElementById('ia-step1-next').addEventListener('click', () => {
    clearError(1);
    emailInput.classList.remove('lm__input--error');
    if (!emailInput.value.trim() || !isValidEmail(emailInput.value)) {
      emailInput.classList.add('lm__input--error');
      showError(1, ERR.email);
      emailInput.focus();
      return;
    }
    showStep(2);
  });

  // STEP 2
  const step2SendBtn = document.getElementById('ia-step2-send');
  step2SendBtn.addEventListener('click', async () => {
    clearError(2);
    const nome = document.getElementById('ia-friend-nome');
    const cognome = document.getElementById('ia-friend-cognome');
    const friendEmail = document.getElementById('ia-friend-email');
    const prefisso = document.getElementById('ia-friend-pfx');
    const cell = document.getElementById('ia-friend-cell');
    const consent = document.getElementById('ia-consent');

    if (!nome.value.trim()) { showError(2, ERR.nome); nome.focus(); return; }
    if (!cognome.value.trim()) { showError(2, ERR.cognome); cognome.focus(); return; }
    if (!friendEmail.value.trim() || !isValidEmail(friendEmail.value)) { showError(2, ERR.friendEmail); friendEmail.focus(); return; }
    if (!cell.value.trim()) { showError(2, ERR.cell); cell.focus(); return; }
    if (!consent.checked) { showError(2, ERR.consent); return; }

    step2SendBtn.disabled = true;
    try {
      await fetch(WEBHOOK_REFERRAL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: emailInput.value.trim(),
          amico: {
            nome: nome.value.trim(),
            cognome: cognome.value.trim(),
            email: friendEmail.value.trim(),
            prefisso: prefisso.value,
            cellulare: cell.value.trim(),
          },
          pagina: openPagina,
          cta: openCta,
          utm: getUtm(),
          vid: getVid(),
        }),
      });
    } catch (e) {}
    step2SendBtn.disabled = false;

    showStep(3);
  });
</script>
