---
import type { Lang } from '../i18n/utils';
import prefissi from '../data/prefissi-telefonici';
import { getEntry } from 'astro:content';

interface Props { lang?: Lang; backHref?: string; }
const { lang = 'it', backHref = '/scuola-tennis' } = Astro.props;

const PREP_SLOTS = ['14:30','15:30','16:30','17:30','18:30'];

// Scadenze, acconto e fasce d'età gestibili da TinaCMS → src/content/moduli/dati-stagionali.md
const d = (await getEntry('moduli', 'dati-stagionali'))!.data;

// Le quote stagionali vivono in TinaCMS (moduli/dati-stagionali): il modulo le
// mostra nel riepilogo prima della firma, il contratto le riporta per intero.
const QUOTE = {
  mini: { mono: d.scuola_quota_mini_mono, bi: d.scuola_quota_mini_bi },
  tennis: { mono: d.scuola_quota_tennis_mono, bi: d.scuola_quota_tennis_bi, tri: d.scuola_quota_tennis_tri },
};

const t = lang === 'en' ? {
  intro: `This is the <strong>course enrolment form</strong>. It can be completed <strong>only after the trial and once the Technical Team has approved</strong> the child's place: days, times and frequency below are the ones agreed with the coaches.`,
  introTrials: 'At the end you will sign the contract, which you will receive by email as a PDF.',

  minorTitle: "Minor's details",
  minorSub: 'Enter the details of the child/teenager to be enrolled.',
  minorFirst: "Child's first name",
  minorLast: "Child's last name",
  minorDob: 'Date of birth',
  minorPob: 'Place of birth',
  minorCf: 'Fiscal code',
