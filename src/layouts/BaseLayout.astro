---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import LeadModal from "../components/LeadModal.astro";
import LeadFormInline from "../components/LeadFormInline.astro";
import InfoPratiche from "../components/InfoPratiche.astro";
import AffiliazioniSlider from "../components/AffiliazioniSlider.astro";
import { getLangFromUrl, useTranslations, getAlternatePath, getLocalePath, publicUrl, type Lang } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  lang?: Lang;
  hideLeadFormInline?: boolean;
  hideChrome?: boolean;
  leadFormStandalone?: boolean;
  leadFormTitle?: string;
  leadFormEyebrow?: string;
}

const { title, description, image, imageAlt, lang: langProp, hideLeadFormInline = false, hideChrome = false, leadFormStandalone = false, leadFormTitle, leadFormEyebrow } = Astro.props;

const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const desc = description ?? t.meta.defaultDescription;

// Strip base URL (es. '/WebSite-TCA') per calcolare i path alternativi
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const cleanPath = base && rawPath.startsWith(base)
  ? (rawPath.slice(base.length) || '/')
  : rawPath;

const { it: itClean } = getAlternatePath(cleanPath);
const siteOrigin = Astro.site?.origin ?? '';
const itHreflang = `${siteOrigin}${getLocalePath('it', itClean)}`;
const enHreflang = `${siteOrigin}${getLocalePath('en', itClean)}`;
const canonicalUrl = `${siteOrigin}${getLocalePath(lang, itClean)}`;

// Foto social-preview: usa l'immagine hero della pagina (già curata in Tina),
// con fallback sulla foto aerea del Club per le pagine senza hero_immagine.
// Facebook/LinkedIn/WhatsApp non leggono in modo affidabile l'AVIF nelle
// anteprime dei link: per ogni hero .avif usiamo il "gemello" .jpg
// (stesso nome file, generato in 1200x630 — il formato/dimensione
// raccomandato da Open Graph) invece del file originale.
const DEFAULT_OG_IMAGE = '/HERO.avif';
const ogImageSrc = (image ?? DEFAULT_OG_IMAGE).replace(/\.avif$/i, '.jpg');
const ogImage = `${siteOrigin}${publicUrl(ogImageSrc)}`;
const ogImageAlt = imageAlt ?? title;
const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = lang === 'it' ? 'en_US' : 'it_IT';
---

<!doctype html>
<html lang={lang} class={hideChrome ? 'is-app-embed' : undefined}>
  <head>
    <!-- ── Google Consent Mode v2 — stato di default ────────────────────
         DEVE restare il primissimo script della pagina: se GTM partisse
         prima di questo, Google considererebbe il consenso concesso e
         traccerebbe senza autorizzazione.

         Tutto negato tranne ciò che è strettamente necessario. GTM si
         carica comunque (vedi sotto), ma in stato limitato: nessun cookie,
         nessun identificativo, solo ping anonimi. Google li usa per
         stimare le conversioni di chi rifiuta, invece di perderle del
         tutto come accadeva col blocco totale dello script.

         wait_for_update dà 500ms a CookieYes per ripristinare la scelta di
         chi ha già acconsentito in una visita precedente, prima che i tag
         inizino a inviare: senza, i primi eventi partirebbero da "negato"
         anche per chi aveva già detto sì. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        personalization_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>

    <!-- Start cookieyes banner: deve restare in alto in <head>, subito dopo
         lo stato di default, perché è lui a comunicare la scelta dell'utente
         (vedi il ponte verso il Consent Mode nello script più in basso). -->
    <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/a52d1f8cdcea8593d12025ba01e05026/script.js"></script>
    <!-- End cookieyes banner -->

    <!-- Preconnect solo a GTM, che è l'unico dominio richiesto subito: la
         connessione si apre in parallelo invece di attendere lo script.
         Gli altri domini Analytics vengono contattati solo dopo il consenso
         (e solo da GTM stesso): per loro basta il dns-prefetch, che risolve
         il DNS senza aprire una connessione. Preconnect va usato con
         parsimonia — oltre 4 origini PSI segnala uno spreco di socket. -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://region1.analytics.google.com" />
    <link rel="dns-prefetch" href="https://stats.g.doubleclick.net" />

    <!-- Google Tag Manager (GA4, Ads, remarketing: tutto è nel container).
         Non è più bloccato con type="text/plain": con il Consent Mode il
         gating non lo fa più il blocco dello script, ma lo stato di consenso
         impostato sopra. GTM parte, legge "negato" e resta in modalità
         senza cookie finché l'utente non accetta. È l'approccio raccomandato
         da Google e l'unico che consente la modellazione delle conversioni
         e, in area SEE, le funzioni di remarketing. -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-WRDQ2RTG');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#8B1A1A" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}logos/tca-logo.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}logos/tca-logo.png`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang — SEO multilingua -->
    <link rel="alternate" hreflang="it"        href={itHreflang} />
    <link rel="alternate" hreflang="en"        href={enHreflang} />
    <link rel="alternate" hreflang="x-default" href={itHreflang} />

    <!-- Open Graph — anteprima social (Facebook, LinkedIn, WhatsApp...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TC Ambrosiano" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Dati strutturati JSON-LD — scheda Google/rich result per il Club
         (indirizzo, orari, contatti, social). TennisComplex è il tipo
         schema.org più specifico disponibile per un circolo di tennis. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TennisComplex",
      "name": "TC Ambrosiano",
      "image": `${siteOrigin}${publicUrl('/HERO.jpg')}`,
      "url": `${siteOrigin}/`,
      "telephone": "+39-02-2641-4392",
      "email": "info@tcambrosiano.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Via Feltre 33",
        "addressLocality": "Milano",
        "postalCode": "20134",
        "addressRegion": "MI",
        "addressCountry": "IT",
      },
      "sameAs": [
        "https://www.instagram.com/clubambrosiano",
        "https://www.facebook.com/tcambrosiano",
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "07:00",
          "closes": "23:59",
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday", "Sunday"],
          "opens": "08:00",
          "closes": "21:00",
        },
      ],
    })} />

    <!-- Google Fonts: Barlow Condensed (display/titoli) + Barlow (body).
         Caricamento non bloccante (preload + swap del media) per non
         ritardare il render del testo: font-display=swap fa il resto. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,300;0,400;0,600;1,300&family=Barlow+Condensed:wght@600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,300;0,400;0,600;1,300&family=Barlow+Condensed:wght@600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,300;0,400;0,600;1,300&family=Barlow+Condensed:wght@600;700;800&display=swap"
      />
    </noscript>
    <slot name="head" />

    <!-- Rilevamento embed in-app (?app=1): nasconde header/footer prima del
         primo paint, per evitare un flash del sito completo. Il sito resta
         completamente statico: nessuna logica lato server, solo una classe
         sull'<html> letta dal CSS globale. -->
    <script is:inline>
      if (new URLSearchParams(location.search).get('app') === '1') {
        document.documentElement.classList.add('is-app-embed');
      }
    </script>

    <!-- UTM/click-id, ID visitatore persistente e beacon "ritorno sul sito":
         script sempre presente (non bloccato via type="text/plain"), ma la
         logica scatta solo con consenso Analytics confermato da CookieYes.
         Lo swap automatico di type="text/plain" -> text/javascript non è
         affidabile per script custom (funziona bene solo per script di terze
         parti riconosciute, es. GTM sotto): usiamo invece gli eventi
         documentati da CookieYes per questo caso (cookieyes_banner_load per
         chi ha già dato consenso in una visita precedente,
         cookieyes_consent_update per chi lo dà ora). -->
    <script is:inline>
      (function () {
        var KEY_VID = 'tca_vid';
        var KEY_UTM = 'tca_utm';
        var WEBHOOK_VISIT = 'https://automazione.n8ndevelop.it/webhook/ping-tca';
        var attivato = false;
        var KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','fbclid','email','userId','userNumber'];

        // ── Coda eventi per GTM ──────────────────────────────────────────
        // dataLayer va inizializzato sempre, non solo a consenso dato: è un
        // semplice array in memoria, non scrive sul dispositivo e non fa
        // chiamate di rete. GTM lo legge solo quando viene attivato dal
        // consenso; senza consenso gli eventi restano lì e non parte nulla.
        window.dataLayer = window.dataLayer || [];
        window.tcaTrack = function (nome, dati) {
          try {
            var ev = { event: nome };
            if (dati) { for (var k in dati) { if (dati[k] != null && dati[k] !== '') ev[k] = dati[k]; } }
            window.dataLayer.push(ev);
          } catch (e) {}
        };

        // ── Attribuzione campagna ────────────────────────────────────────
        // Leggere i parametri dall'URL non è archiviazione nel terminale
        // (art. 122 Codice Privacy / art. 5(3) ePrivacy): è solo lettura
        // della barra degli indirizzi, quindi non richiede consenso. Il
        // dato viaggia poi insieme al lead che l'utente invia di sua
        // iniziativa, sulla stessa base giuridica della richiesta.
        function utmDaUrl() {
          var out = {};
          try {
            var params = new URLSearchParams(location.search);
            KEYS.forEach(function (k) { if (params.has(k)) out[k] = params.get(k); });
          } catch (e) {}
          return out;
        }

        function utmSalvati() {
          try { return JSON.parse(sessionStorage.getItem(KEY_UTM) || '{}'); } catch (e) { return {}; }
        }

        // Attribuzione esposta ai form: vince il primo tocco memorizzato
        // (disponibile solo con consenso), altrimenti si ricade sull'URL
        // corrente. Così un lead da campagna resta attribuito anche se
        // l'utente rifiuta i cookie, purché converta sulla pagina d'arrivo.
        // Il set è atomico: o tutto il primo tocco o tutto l'URL corrente,
        // mai un misto, altrimenti si otterrebbero record incoerenti (es.
        // source di una campagna e campaign di un'altra).
        window.tcaGetUtm = function () {
          var salvati = utmSalvati();
          return Object.keys(salvati).length ? salvati : utmDaUrl();
        };

        // Propagazione UTM tra le pagine del sito: come sopra, è solo
        // lettura dell'URL corrente e riscrittura dei link in uscita, non
        // archiviazione sul dispositivo, quindi non richiede consenso e
        // funziona anche per chi rifiuta i cookie. Senza questo, i parametri
        // spariscono al primo click perché i link interni non li portano.
        function propagaUtm() {
          var utm = window.tcaGetUtm();
          var chiavi = Object.keys(utm);
          if (!chiavi.length) return;

          try {
            var qui = new URL(location.href);
            var mancano = chiavi.some(function (k) { return qui.searchParams.get(k) !== utm[k]; });
            if (mancano) {
              chiavi.forEach(function (k) { qui.searchParams.set(k, utm[k]); });
              history.replaceState(history.state, '', qui.toString());
            }
          } catch (e) {}

          document.addEventListener('click', function (ev) {
            var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (!href || href.charAt(0) === '#' || /^(mailto:|tel:|javascript:)/i.test(href)) return;
            try {
              var dest = new URL(a.href, location.href);
              if (dest.origin !== location.origin) return;
              var cambia = false;
              chiavi.forEach(function (k) {
                if (dest.searchParams.get(k) !== utm[k]) { dest.searchParams.set(k, utm[k]); cambia = true; }
              });
              if (cambia) a.href = dest.toString();
            } catch (e) {}
          }, true);
        }
        propagaUtm();

        // Memorizzare, invece, è archiviazione nel terminale: resta
        // subordinato al consenso analytics, come il vid e il beacon.
        function catturaUtm() {
          try {
            if (sessionStorage.getItem(KEY_UTM)) return;
            var found = utmDaUrl();
            if (Object.keys(found).length) sessionStorage.setItem(KEY_UTM, JSON.stringify(found));
          } catch (e) {}
        }

        function generaVid() {
          var vid;
          try { vid = localStorage.getItem(KEY_VID); } catch (e) { vid = null; }
          if (!vid) {
            vid = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() :
              'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
              });
            try { localStorage.setItem(KEY_VID, vid); } catch (e) {}
          }
          window.tcaGetVid = function () { return vid; };
        }

        function inviaBeacon() {
          var utm = {};
          try { utm = JSON.parse(sessionStorage.getItem(KEY_UTM) || '{}'); } catch (e) {}
          var body = JSON.stringify({
            vid: window.tcaGetVid ? window.tcaGetVid() : null,
            pagina: location.pathname,
            referrer: document.referrer || null,
            utm: utm
          });
          // Content-Type "text/plain" e non "application/json": è uno dei
          // content-type "semplici" CORS-safelisted, quindi niente preflight
          // cross-origin. sendBeacon include sempre le credenziali (a
          // differenza di fetch di default) e n8n non risponde con
          // Access-Control-Allow-Credentials: true, quindi con
          // application/json il preflight fallisce e il browser non invia
          // affatto la richiesta reale (verificato in DevTools: 0 esecuzioni
          // su n8n). In modalità "semplice" la richiesta parte comunque
          // anche se la risposta resta illeggibile, che qui non ci serve.
          // n8n riceve comunque JSON valido: va solo fatto JSON.parse(body).
          if (navigator.sendBeacon) {
            navigator.sendBeacon(WEBHOOK_VISIT, new Blob([body], { type: 'text/plain;charset=UTF-8' }));
          } else {
            fetch(WEBHOOK_VISIT, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=UTF-8' }, body: body, keepalive: true }).catch(function () {});
          }
        }

        function attivaTracciamento() {
          if (attivato) return;
          attivato = true;
          catturaUtm();
          generaVid();
          inviaBeacon();
        }

        // ── Ponte CookieYes → Google Consent Mode ────────────────────────
        // Traduce le categorie del banner nei segnali che GTM/GA4/Ads
        // leggono. Lo facciamo qui invece di affidarci all'integrazione
        // nativa di CookieYes: non dipende dal piano sottoscritto e resta
        // sotto il nostro controllo. Per questo motivo l'integrazione
        // Consent Mode di CookieYes va lasciata DISATTIVATA, altrimenti si
        // avrebbero due sorgenti che inviano gli stessi segnali.
        function aggiornaConsenso(analytics, marketing) {
          if (typeof gtag !== 'function') return;
          gtag('consent', 'update', {
            analytics_storage: analytics ? 'granted' : 'denied',
            ad_storage: marketing ? 'granted' : 'denied',
            ad_user_data: marketing ? 'granted' : 'denied',
            ad_personalization: marketing ? 'granted' : 'denied',
            personalization_storage: marketing ? 'granted' : 'denied',
          });
        }

        // Visitatore che ha già dato consenso in una visita precedente:
        // l'API/i dati di consenso sono disponibili solo a banner caricato.
        document.addEventListener('cookieyes_banner_load', function (e) {
          var categorie = (e.detail && e.detail.categories) || {};
          aggiornaConsenso(!!categorie.analytics, !!categorie.advertisement);
          if (categorie.analytics) attivaTracciamento();
        });

        // Visitatore che accetta (o cambia preferenze) ora dal banner.
        document.addEventListener('cookieyes_consent_update', function (e) {
          var accettate = (e.detail && e.detail.accepted) || [];
          aggiornaConsenso(
            accettate.indexOf('analytics') !== -1,
            accettate.indexOf('advertisement') !== -1
          );
          if (accettate.indexOf('analytics') !== -1) attivaTracciamento();
        });
      })();
    </script>
  </head>
  <body>
    <!-- L'iframe <noscript> di GTM è stato rimosso di proposito: con
         JavaScript disabilitato il Consent Mode non può funzionare, quindi
         quell'iframe caricherebbe GTM scavalcando il consenso. Senza JS la
         misurazione sarebbe comunque quasi nulla, per cui si perde niente. -->

    {!hideChrome && <Navbar lang={lang} />}
    <main class="site-main">
      <slot />
    </main>
    {!hideLeadFormInline && <LeadFormInline lang={lang} standalone={leadFormStandalone} standaloneTitle={leadFormTitle} standaloneEyebrow={leadFormEyebrow} />}
    {!hideChrome && <InfoPratiche lang={lang} />}
    {!hideChrome && <AffiliazioniSlider lang={lang} />}
    {!hideChrome && <Footer lang={lang} />}
    <LeadModal lang={lang} />

    <!-- ── Back to top ── -->
    <button id="back-to-top" aria-label="Torna in cima" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <style>
      #back-to-top {
        position: fixed;
        bottom: clamp(1.2rem, 3vh, 2rem);
        right: clamp(1rem, 3vw, 2rem);
        z-index: 900;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-accent);
        color: #fff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(139,26,26,0.35);
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.25s, transform 0.25s, background 0.18s;
        pointer-events: none;
      }
      #back-to-top:not([hidden]) { pointer-events: auto; }
      #back-to-top.is-visible { opacity: 1; transform: translateY(0); }
      #back-to-top:hover { background: var(--color-accent-dark); }
    </style>

    <script>
      // ── Scroll animations ──────────────────────────────────────────────────

      // rootMargin '0px' — nessuna soglia negativa che esclude elementi
      // a bordo viewport; threshold 0.05 = scatta appena 5% è visibile.
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const delay = el.dataset.animDelay ? parseInt(el.dataset.animDelay, 10) : 0;
          setTimeout(() => el.classList.add('is-visible'), delay);
          obs.unobserve(el);
        });
      }, { threshold: 0.05, rootMargin: '0px' });

      function register(
        selector: string,
        type: string,
        baseDelay = 0,
        stagger = 0
      ) {
        document.querySelectorAll<HTMLElement>(selector).forEach((el, i) => {
          if (el.closest('.hero')) return;
          // Non sovrascrivere animazioni già definite nel markup
          if (!el.hasAttribute('data-anim')) el.setAttribute('data-anim', type);
          if (!el.dataset.animDelay && (baseDelay + stagger * i) > 0) {
            el.dataset.animDelay = String(baseDelay + stagger * i);
          }
          obs.observe(el);
        });
      }

      const NH = 'section:not(.hero)';

      // ── Titoli: wipe sinistra→destra ──
      // Escludi .panel__head h2 (AttivitaSplit: ha animazioni proprie sulle righe)
      register(`${NH} h2:not(.panel__title)`,  'reveal',     0,   0);
      register(`${NH} h3`,                     'reveal',    60,   0);

      // ── Eyebrow: slide da sinistra (escludi panel__head che è su sfondo scuro) ──
      register(`${NH} .eyebrow:not(.eyebrow--light)`, 'from-left', 0, 0);

      // ── Panel testa AttivitaSplit: solo fade (già su sfondo scuro, opacity è critica) ──
      register('.panel__head .eyebrow',        'fade',       0,   0);
      register('.panel__title',                'from-left', 60,   0);
      register('.panel__sub',                  'fade',     120,   0);

      // ── Testi / body copy ──
      register('.manifesto__body p',           'from-left', 120, 100);
      register('.manifesto__quote',            'reveal',    200,   0);
      register('.torneo__body',                'from-left', 100,   0);

      // ── Stats Torneo: scale-in in sequenza ──
      register('.torneo__stat',                'scale',     150,  90);

      // ── Pulsanti / CTA: accento "pop" con rimbalzo ──
      register(`${NH} .btn`,                   'pop',       140,  60);

      // ── Card / blocchi ──
      register('.conversion__card',            'true',        0, 120);
      register('.info__item',                  'true',        0,  80);
      register('.info__actions',               'true',      240,   0);
      // .reassurance__item rimosso — sezione why ha logica cycling propria
      register('.eventi-home__head',           'from-left',   0,   0);
      register('.event-item',                  'true',        0, 100);
      // NB: la mappa (.info__map) NON viene animata: applicare
      // transform/filter/will-change a un contenitore che avvolge un iframe
      // cross-origin (Google Maps) provoca un bug di compositing in Chromium
      // per cui l'iframe resta vuoto o non si carica. La mappa è quindi statica.

      // ── Card disciplina (tennis / padel / scuola / agonistica) ──
      register('.content-card',                'true',        0, 100);
      register('.age-card',                    'true',        0,  90);
      register('.step',                        'true',        0, 100);
      register('.feature',                     'true',        0,  90);
      register('.timeline__item',              'true',        0,  80);
      register('.stat-item',                   'scale',     100,  80);
      register('.stat',                        'scale',     100,  80);

      // ── Immagini e media ──
      register('.two-col__image',              'scale',      60,   0);
      register('.rounded-img',                 'scale',      60,   0);
      register('.gallery__img',                'scale',       0,  80);
      register('.camp-img',                    'scale',       0,  90);
      register('.sala-split__media',           'scale',      60,   0);

      // ── Testo body su pagine di disciplina ──
      register(`${NH} .body-text`,             'from-left',  80,   0);
      register(`${NH} .sala-body`,             'from-left',  80,   0);
      register(`${NH} .sala-feat`,             'from-left',  80,  60);
      register(`${NH} .cat-block__desc`,       'from-left',  80,   0);
      register(`${NH} .lfi__sub`,              'from-left',  80,   0);

      // ── Elementi già marcati nel markup ──
      document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
        if (!el.classList.contains('is-visible')) obs.observe(el);
      });

      // ── Fallback 1: elementi già nel viewport al caricamento ──
      requestAnimationFrame(() => {
        const vh = window.innerHeight;
        document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
          if (el.classList.contains('is-visible')) return;
          const rect = el.getBoundingClientRect();
          if (rect.top < vh + 60 && rect.bottom > 0) {
            const delay = el.dataset.animDelay ? parseInt(el.dataset.animDelay, 10) : 0;
            setTimeout(() => el.classList.add('is-visible'), delay);
          }
        });
      });

      // ── Failsafe solo se IntersectionObserver non è supportato ──
      // (browser molto vecchi): in tal caso rivela tutto, altrimenti
      // l'animazione resta legata allo scroll tramite l'observer.
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => {
          el.classList.add('is-visible');
        });
      }

      // ── Back to top ──────────────────────────────────────────────────
      const btt = document.getElementById('back-to-top') as HTMLButtonElement | null;
      if (btt) {
        const THRESHOLD = 400;
        const toggle = () => {
          const show = window.scrollY > THRESHOLD;
          if (show) { btt.hidden = false; requestAnimationFrame(() => btt.classList.add('is-visible')); }
          else       { btt.classList.remove('is-visible'); }
        };
        window.addEventListener('scroll', toggle, { passive: true });
        btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
