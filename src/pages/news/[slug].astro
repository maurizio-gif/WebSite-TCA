---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePath, getLangFromUrl, publicUrl, type Lang } from '../../i18n/utils';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => data.pubblicato);
  return news.map((entry) => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const nw = entry.data;

const lang: Lang = getLangFromUrl(Astro.url);
const p = (path: string) => getLocalePath(lang, path);

const MESI_FULL = [
  'gennaio','febbraio','marzo','aprile','maggio','giugno',
  'luglio','agosto','settembre','ottobre','novembre','dicembre',
];
const dataFormattata =
  `${nw.data.getDate()} ${MESI_FULL[nw.data.getMonth()]} ${nw.data.getFullYear()}`;

const ctaExternal = !!nw.cta_href && !nw.cta_href.startsWith('/');
const ctaHref = nw.cta_href
  ? (nw.cta_href.startsWith('/') ? p(nw.cta_href) : nw.cta_href)
  : null;
---

<BaseLayout
  lang={lang}
  title={`${nw.titolo} — TC Ambrosiano`}
  description={nw.sintesi}
  image={nw.immagine}
  imageAlt={nw.immagine_alt}
>
  <!-- Hero news: foto a piena larghezza come sfondo del titolo -->
  <section class="nw-hero">
    <div class="nw-hero__bg">
      <img
        src={publicUrl(nw.immagine)}
        alt={nw.immagine_alt}
        class="nw-hero__img"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="nw-hero__grad"></div>

    <div class="nw-hero__inner">
      <nav class="nw-hero__breadcrumb" aria-label="Breadcrumb">
        <a href={`${p('/club-life')}#news`}>← Club Life</a>
      </nav>

      <div class="nw-hero__meta">
        <span class="nw-hero__cat">{nw.categoria}</span>
        <time class="nw-hero__date" datetime={nw.data.toISOString().split('T')[0]}>
          {dataFormattata}
        </time>
      </div>

      <h1 class="nw-hero__title">{nw.titolo}</h1>

      <p class="nw-hero__desc">{nw.sintesi}</p>
    </div>
  </section>

  <!-- Contenuto news -->
  <section class="nw-body">
    <div class="nw-body__inner">
      <div class="nw-body__content prose rich-body">
        <Content />
      </div>

      <aside class="nw-body__sidebar">
        <div class="nw-sidebar__block">
          <h2 class="nw-sidebar__label">Data</h2>
          <p class="nw-sidebar__value">{dataFormattata}</p>
        </div>

        <div class="nw-sidebar__block">
          <h2 class="nw-sidebar__label">Categoria</h2>
          <p class="nw-sidebar__value">{nw.categoria}</p>
        </div>

        {ctaHref && nw.cta_label && (
          <div class="nw-sidebar__cta">
            <a
              class="btn btn-red"
              href={ctaHref}
              target={ctaExternal ? '_blank' : undefined}
              rel={ctaExternal ? 'noopener noreferrer' : undefined}
              style="width:100%;text-align:center;"
            >{nw.cta_label}</a>
          </div>
        )}

        <div class="nw-sidebar__back">
          <a href={`${p('/club-life')}#news`}>← Tutte le news</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero: foto piena larghezza con overlay, titolo sopra ── */
  .nw-hero {
    position: relative;
    min-height: 52vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-top: var(--header-h);
    border-bottom: 3px solid var(--color-accent);
  }

  .nw-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0f1013;
  }

  .nw-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nw-hero__grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15,15,18,0.35) 0%, rgba(15,15,18,0.72) 60%, rgba(15,15,18,0.92) 100%);
  }

  .nw-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6vh var(--pad-x) 5vh;
    color: #ffffff;
  }

  .nw-hero__breadcrumb { margin-bottom: 2.5vh; }

  .nw-hero__breadcrumb a {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.8vw, 12px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.55);
    text-decoration: none;
    transition: color 0.18s;
  }

  .nw-hero__breadcrumb a:hover { color: rgba(255,255,255,.9); }

  .nw-hero__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }

  .nw-hero__cat {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3em 0.8em;
    background: rgba(255,255,255,.1);
    color: #ffffff;
    border-left: 3px solid var(--color-accent);
  }

  .nw-hero__date {
    font-family: var(--font-body);
    font-size: clamp(12px, 0.9vw, 14px);
    font-weight: 300;
    color: rgba(255,255,255,.7);
    letter-spacing: 0.06em;
  }

  .nw-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 5.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.95;
    color: #ffffff;
    margin-bottom: 1.6rem;
    max-width: 24ch;
    text-wrap: balance;
  }

  .nw-hero__desc {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.2vw, 20px);
    font-weight: 300;
    line-height: 1.75;
    color: rgba(255,255,255,.82);
    max-width: 62ch;
  }

  /* ── Body ── */
  .nw-body {
    padding: 6vh var(--pad-x);
    background: var(--color-bg);
  }

  .nw-body__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 5rem;
    align-items: start;
  }

  /* Prose: tipografia di base — spaziatura/grassetto/link li gestisce la
     classe globale .rich-body (vedi src/styles/global.css) */
  .prose {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.1vw, 20px);
    font-weight: 300;
    line-height: 1.85;
    color: var(--color-text-light);
  }

  /* Sidebar */
  .nw-body__sidebar {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    border: 1px solid var(--color-border);
    padding: 1.8rem;
    background: var(--color-off-white);
  }

  .nw-sidebar__block {
    padding-bottom: 1.2rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .nw-sidebar__label {
    font-family: var(--font-display);
    font-size: clamp(11px, 0.72vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26,26,26,.38);
    margin-bottom: 0.35rem;
  }

  .nw-sidebar__value {
    font-family: var(--font-body);
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 400;
    color: var(--color-text);
  }

  .nw-sidebar__cta {
    margin-top: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .nw-sidebar__back { margin-top: 1.2rem; }

  .nw-sidebar__back a {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.78vw, 12px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(26,26,26,.4);
    text-decoration: none;
    transition: color 0.18s;
  }

  .nw-sidebar__back a:hover { color: var(--color-accent); }

  @media (max-width: 900px) {
    .nw-body__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .nw-body__sidebar { position: static; }
  }

  @media (max-width: 560px) {
    .nw-hero { min-height: 42vh; }
    .nw-hero__title { font-size: clamp(1.8rem, 8vw, 3rem); }
  }
</style>
