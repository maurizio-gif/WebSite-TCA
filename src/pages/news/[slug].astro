---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalePath, getLangFromUrl, publicUrl, type Lang } from '../../i18n/utils';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => data.pubblicato);
  return news.map((entry) => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const nw = entry.data;

const lang: Lang = getLangFromUrl(Astro.url);
const p = (path: string) => getLocalePath(lang, path);

const MESI_FULL = [
  'gennaio','febbraio','marzo','aprile','maggio','giugno',
  'luglio','agosto','settembre','ottobre','novembre','dicembre',
];
const dataFormattata =
  `${nw.data.getDate()} ${MESI_FULL[nw.data.getMonth()]} ${nw.data.getFullYear()}`;

const ctaExternal = !!nw.cta_href && !nw.cta_href.startsWith('/');
const ctaHref = nw.cta_href
  ? (nw.cta_href.startsWith('/') ? p(nw.cta_href) : nw.cta_href)
  : null;
---

<BaseLayout
  lang={lang}
  title={`${nw.titolo} — TC Ambrosiano`}
  description={nw.sintesi}
  image={nw.immagine}
  imageAlt={nw.immagine_alt}
>
  <!-- Hero news -->
  <section class="nw-hero">
    <div class="nw-hero__inner">
      <nav class="nw-hero__breadcrumb" aria-label="Breadcrumb">
        <a href={`${p('/club-life')}#news`}>← Club Life</a>
      </nav>

      <div class="nw-hero__meta">
        <span class="nw-hero__cat">{nw.categoria}</span>
      </div>

      <time class="nw-hero__date" datetime={nw.data.toISOString().split('T')[0]}>
        {dataFormattata}
      </time>

      <h1 class="nw-hero__title">{nw.titolo}</h1>

      <p class="nw-hero__desc">{nw.sintesi}</p>
    </div>
  </section>

  <!-- Contenuto news -->
  <section class="nw-body">
    <div class="nw-body__inner">
      <div class="nw-body__media">
        <img src={publicUrl(nw.immagine)} alt={nw.immagine_alt} class="nw-body__img" />
      </div>

      <div class="nw-body__content prose">
        <Content />
      </div>

      <aside class="nw-body__sidebar">
        <div class="nw-sidebar__block">
          <h2 class="nw-sidebar__label">Data</h2>
          <p class="nw-sidebar__value">{dataFormattata}</p>
        </div>

        <div class="nw-sidebar__block">
          <h2 class="nw-sidebar__label">Categoria</h2>
          <p class="nw-sidebar__value">{nw.categoria}</p>
        </div>

        {ctaHref && nw.cta_label && (
          <div class="nw-sidebar__cta">
            <a
              class="btn btn-red"
              href={ctaHref}
              target={ctaExternal ? '_blank' : undefined}
              rel={ctaExternal ? 'noopener noreferrer' : undefined}
              style="width:100%;text-align:center;"
            >{nw.cta_label}</a>
          </div>
        )}

        <div class="nw-sidebar__back">
          <a href={`${p('/club-life')}#news`}>← Tutte le news</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .nw-hero {
    background: #0f1013;
    padding: calc(var(--header-h) + 5vh) var(--pad-x) 6vh;
    border-bottom: 3px solid var(--color-accent);
  }

  .nw-hero__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    color: #ffffff;
  }

  .nw-hero__breadcrumb { margin-bottom: 2.5vh; }

  .nw-hero__breadcrumb a {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.8vw, 12px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,.4);
    text-decoration: none;
    transition: color 0.18s;
  }

  .nw-hero__breadcrumb a:hover { color: rgba(255,255,255,.8); }

  .nw-hero__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }

  .nw-hero__cat {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3em 0.8em;
    background: rgba(255,255,255,.07);
    color: rgba(255,255,255,.7);
    border-left: 3px solid var(--color-accent);
  }

  .nw-hero__date {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(12px, 0.9vw, 14px);
    font-weight: 300;
    color: rgba(255,255,255,.4);
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    text-transform: lowercase;
  }

  .nw-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 6rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.9;
    color: #ffffff;
    margin-bottom: 2rem;
    max-width: 24ch;
  }

  .nw-hero__desc {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.2vw, 21px);
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255,255,255,.62);
    max-width: 60ch;
  }

  /* ── Body ── */
  .nw-body {
    padding: 6vh var(--pad-x);
    background: var(--color-bg);
  }

  .nw-body__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 5rem;
    align-items: start;
  }

  .nw-body__media {
    grid-column: 1;
    margin-bottom: 1rem;
  }

  .nw-body__img {
    width: 100%;
    aspect-ratio: 16/8;
    object-fit: cover;
    display: block;
  }

  /* Prose */
  .prose {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.1vw, 20px);
    font-weight: 300;
    line-height: 1.85;
    color: var(--color-text-light);
  }

  .prose p { margin-bottom: 1.2em; }

  .prose h2, .prose h3 {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text);
    margin-top: 1.8em;
    margin-bottom: 0.6em;
    letter-spacing: -0.01em;
  }

  .prose h2 { font-size: clamp(1.3rem, 2vw, 1.8rem); }
  .prose h3 { font-size: clamp(1.1rem, 1.5vw, 1.4rem); }

  .prose ul, .prose ol { padding-left: 1.5em; margin-bottom: 1em; }
  .prose li { margin-bottom: 0.4em; }

  /* Sidebar */
  .nw-body__sidebar {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    border: 1px solid var(--color-border);
    padding: 1.8rem;
    background: var(--color-off-white);
  }

  .nw-sidebar__block {
    padding-bottom: 1.2rem;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .nw-sidebar__label {
    font-family: var(--font-display);
    font-size: clamp(11px, 0.72vw, 11px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26,26,26,.38);
    margin-bottom: 0.35rem;
  }

  .nw-sidebar__value {
    font-family: var(--font-body);
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 400;
    color: var(--color-text);
  }

  .nw-sidebar__cta {
    margin-top: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .nw-sidebar__back { margin-top: 1.2rem; }

  .nw-sidebar__back a {
    font-family: var(--font-display);
    font-size: clamp(10px, 0.78vw, 12px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(26,26,26,.4);
    text-decoration: none;
    transition: color 0.18s;
  }

  .nw-sidebar__back a:hover { color: var(--color-accent); }

  @media (max-width: 900px) {
    .nw-body__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .nw-body__sidebar { position: static; }
  }

  @media (max-width: 560px) {
    .nw-hero { padding-top: calc(var(--header-h) + 3vh); }
    .nw-hero__title { font-size: clamp(1.8rem, 8vw, 3rem); }
  }
</style>
