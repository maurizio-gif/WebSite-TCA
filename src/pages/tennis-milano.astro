    .lp-actions .btn { flex: 1 1 100%; text-align: center; }
    .lp-tennis__media img,
    .lp-community__media img { height: clamp(240px, 46vh, 400px); }
    .lp-gallery__track { height: clamp(200px, 52vw, 320px); }
