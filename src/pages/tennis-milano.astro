---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reassurance from "../components/Reassurance.astro";
import WeeklySchedule from "../components/WeeklySchedule.astro";
import { publicUrl, type Lang } from "../i18n/utils";

// Landing page dedicata alle campagne Google Ads (tennis + membership).
// Solo italiano, noindex, lead-gen tramite LeadModal (#modal-contatti) già
// tracciato via UTM/click-id in BaseLayout. Nessuna iscrizione online: ogni
// CTA apre il form lead (Prenota una visita / Richiedi informazioni).
const lang: Lang = "it";

const heroImg  = publicUrl("/HERO.avif");
const tennisImg = publicUrl("/Tennis-Milano-Hero.avif");
const communityImg = publicUrl("/TCA-Community.avif");

// Galleria dinamica Preparazione Atletica — foto corsi di gruppo, dimensioni
// variabili (wide/square/tall) per un effetto masonry scorribile lateralmente
const prepGallery = [
  { src: "/TCA-Corsi-PowerYoga.avif",         alt: "Corso di Power Yoga al TC Ambrosiano", size: "wide" },
  { src: "/TCA-Corsi-PilatesFunzionale.avif", alt: "Corso di Pilates Funzionale in sala corsi",      size: "tall" },
  { src: "/TCA-Corsi-Functional.avif",        alt: "Allenamento funzionale di gruppo",               size: "square" },
  { src: "/TCA-Corsi-Aeroboxe.avif",          alt: "Corso di Aeroboxe",                              size: "wide" },
  { src: "/TCA-Corsi-Zumba.avif",             alt: "Corso di Zumba",                                 size: "tall" },
  { src: "/TCA-Corsi-TotalBody.avif",         alt: "Corso Total Body",                               size: "wide" },
  { src: "/TCA-Corsi-TribalX.avif",           alt: "Corso Tribal-X, allenamento funzionale di gruppo", size: "square" },
  { src: "/TCA-Corsi-Dance.avif",             alt: "Corso di Dance",                                 size: "tall" },
].map((s) => ({ ...s, src: publicUrl(s.src) }));

// Icone card "Vita di Club"
const vitaIcons = [
  '<path d="M5 4h14l-6.2 7.4V18m-3.6 0h7.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6.3 6h11.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  '<path d="M8 4h8v5a4 4 0 0 1-8 0V4z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 5H5.5A1.5 1.5 0 0 0 4 6.5v.5A3 3 0 0 0 7 10M16 5h2.5A1.5 1.5 0 0 1 20 6.5v.5a3 3 0 0 1-3 3M9 20h6M12 13v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  '<circle cx="8" cy="8" r="2.4" stroke="currentColor" stroke-width="1.8"/><circle cx="16" cy="8" r="2.4" stroke="currentColor" stroke-width="1.8"/><path d="M3 19c0-2.8 2.2-5 5-5s5 2.2 5 5M11 19c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
];

// Icone card "Allenamento e benessere"
const prepIcons = [
  '<path d="M4 12h2m12 0h2M6 9v6M18 9v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="8" y="8" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.8"/>',
  '<rect x="4" y="5" width="16" height="15" rx="1.5" stroke="currentColor" stroke-width="1.8"/><path d="M4 9h16M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  '<circle cx="12" cy="7" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
];

const stats = [
  { num: "1963", label: "Anno di fondazione", countTo: 1963 },
  { num: "16",   label: "Campi, tutte le superfici", countTo: 16 },
  { num: "30.000+", label: "Mq dedicati allo sport", countTo: 30000, suffix: "+", thousands: true },
  { num: "FITP", label: "Maestri federali qualificati" },
];

// Cosa include l'abbonamento (senza prezzi, solo vantaggi)
const inclusi = [
  "Accesso ai campi da tennis outdoor e indoor",
  "Campi da padel dedicati",
  "Sala attrezzi professionale, tutti i giorni",
  "Oltre 80 corsi di gruppo a settimana",
  "Priorità di prenotazione campi (fino a 10 giorni)",
  "Tariffe agevolate su corsi e lezioni individuali",
];

const tiers = [
  {
    nome: "Silver",
    color: "#6B7280",
    desc: "L'essenziale per allenarti: sala attrezzi, corsi selezionati e sconto soci sui campi.",
  },
  {
    nome: "Gold",
    color: "#A07B10",
    desc: "Più campo e più corsi: tennis outdoor incluso, tutti i corsi di gruppo, 7 giorni di anticipo.",
  },
  {
    nome: "Platinum",
    color: "var(--color-accent)",
    badge: "Più completo",
    desc: "L'esperienza completa: tennis e padel indoor/outdoor inclusi, 10 giorni di anticipo, massima priorità.",
  },
];

const prepFeatures = [
  { titolo: "Sala attrezzi", testo: "Macchinari isotonici di ultima generazione, area cardio completa, pesi liberi e zona funzionale con TRX e kettlebell" },
  { titolo: "80+ corsi / settimana", testo: "Cycling, Functional, Pilates, Yoga e molto altro" },
  { titolo: "Personal trainer", testo: "Programmi su misura e sport-specific per tennisti" },
];

const communityFeatures = [
  { titolo: "Aperitivi e serate a tema", testo: "In terrazza, dopo l'ultimo game, con vista sui campi" },
  { titolo: "Tornei sociali", testo: "Gare amichevoli tra soci, per ogni livello di gioco" },
  { titolo: "Eventi per famiglie", testo: "Feste, giornate a bordo campo e momenti per i più piccoli" },
];
---

<BaseLayout
  lang={lang}
  title="Tennis a Milano dal 1963 | TC Ambrosiano"
  description="Gioca a tennis al TC Ambrosiano: 16 campi, maestri federali FITP, palestra e membership. A due passi dalla metro Udine. Prenota una visita gratuita."
  image="/HERO.avif"
  imageAlt="TC Ambrosiano — vista aerea dei campi"
  hideChrome={true}
  hideLeadFormInline={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <!-- ═══ HERO + STATS: su desktop restano nella stessa schermata (100vh) ═══ -->
  <div class="lp-hero-group">
    <!-- ═══════════════════ HERO ═══════════════════ -->
    <section class="lp-hero hero">
      <div class="lp-hero__bg">
        <img src={heroImg} alt="TC Ambrosiano — vista aerea dei campi"
             class="lp-hero__img" fetchpriority="high" loading="eager" decoding="async" />
      </div>
      <div class="lp-hero__grad"></div>

      <div class="lp-hero__content">
        <span class="eyebrow eyebrow--light">Dal 1963, il tennis a Milano</span>
        <h1 class="lp-hero__title">Gioca a tennis <br class="lp-hero__break--mobile" />dove è nata<br><em>la tradizione milanese</em></h1>
        <p class="lp-hero__sub">
          Sedici campi su ogni superficie, maestri federali FITP e oltre 30.000 mq
          di sport a due passi dalla metro Udine. E il tennis è solo l'inizio: la
          nostra <strong>preparazione atletica</strong> offre oltre <strong>80
          corsi a settimana</strong> e aree dedicate ad allenamento
          <strong>cardio</strong>, <strong>isotonico</strong> e <strong>funzionale</strong>.
        </p>
        <div class="lp-hero__actions">
          <button class="btn btn-red" data-open-modal="modal-contatti">Prenota una visita</button>
          <button class="btn btn-outline" data-open-modal="modal-contatti">Richiedi informazioni</button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════ STATS ═══════════════════ -->
    <section class="lp-stats">
      <div class="lp-stats__inner">
        {stats.map((s, i) => (
          <div class="lp-stat" data-anim="scale" data-anim-delay={String(i * 90)}>
            <span
              class="lp-stat__num"
              data-count-to={s.countTo ?? undefined}
              data-suffix={s.suffix ?? ""}
              data-thousands={s.thousands ? "1" : ""}
            >{s.countTo !== undefined ? "0" : s.num}</span>
            <span class="lp-stat__label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- ═══════════════════ TENNIS ═══════════════════ -->
  <section class="lp-tennis" id="campi">
    <div class="lp-tennis__inner">
      <div class="lp-tennis__body">
        <span class="eyebrow">Il tennis al TCA</span>
        <h2 class="lp-title">Sedici campi,<br><em>tutto l'anno</em></h2>
        <p class="lp-lead">
          Sedici campi su ogni superficie — terra rossa omologata FITP, campi
          indoor coperti e riscaldati per giocare anche d'inverno, e superfici
          rapide. Come socio giochi quando vuoi, con la priorità di prenotazione
          della tua membership.
        </p>

        <div class="lp-appendix" id="corsi">
          <p>
            <strong>Vuoi ricominciare a giocare o imparare da zero?</strong>
            Affidati ai nostri tecnici federali FITP: corsi per adulti di ogni
            livello, in piccoli gruppi o individuali. E come Member hai sempre
            una <strong>tariffa agevolata</strong>.
          </p>
        </div>

        <div class="lp-actions">
          <button class="btn btn-red" data-open-modal="modal-contatti">Prenota una visita</button>
          <button class="btn btn-outline--dark" data-open-modal="modal-contatti">Richiedi informazioni</button>
        </div>
      </div>
      <div class="lp-tennis__media">
        <img src={tennisImg} alt="Maestro e allieva del TC Ambrosiano si scambiano il cinque a rete"
             loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ MEMBERSHIP ═══════════════════ -->
  <section class="lp-member" id="membership">
    <div class="lp-member__inner">
      <div class="lp-member__head">
        <span class="eyebrow">Diventa socio</span>
        <h2 class="lp-title">Un'unica tessera,<br><em>tutto il Club</em></h2>
        <p class="lp-lead">
          Con la membership del TC Ambrosiano giochi tutto l'anno sui
          sedici campi, outdoor e indoor — e a padel sui campi dedicati. Tre
          livelli pensati per esigenze diverse.
        </p>
      </div>

      <div class="lp-member__grid">
        <div class="lp-inclusi">
          <p class="lp-inclusi__title">Cosa include l'abbonamento</p>
          <ul class="lp-inclusi__list">
            {inclusi.map((v) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-opacity=".25"/>
                  <path d="M5 9.5l2.8 2.8 5.2-6" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lp-tiers">
          {tiers.map((t) => (
            <div class={`lp-tier${t.badge ? " lp-tier--plat" : ""}`}>
              {t.badge && <span class="lp-tier__badge">{t.badge}</span>}
              <span class="lp-tier__name" style={`color:${t.color}`}>{t.nome}</span>
              <p class="lp-tier__desc">{t.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="lp-actions lp-actions--center">
        <button class="btn btn-red" data-open-modal="modal-contatti">Prenota una visita</button>
        <button class="btn btn-outline--dark" data-open-modal="modal-contatti">Richiedi informazioni</button>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PREPARAZIONE ATLETICA ═══════════════════ -->
  <section class="lp-prep">
    <div class="lp-prep__inner">
      <div class="lp-prep__top">
        <div class="lp-prep__body">
          <span class="eyebrow">Preparazione Atletica</span>
          <h2 class="lp-title">Allenamento e benessere,<br><em>inclusi</em></h2>
          <p class="lp-lead">
            Sala attrezzi professionale riservata ai soci, con macchinari isotonici
            di ultima generazione, area cardio e zona funzionale. Al fianco, personal
            trainer qualificati per un programma su misura. E ogni settimana oltre 80
            corsi di gruppo: endurance, forza ed equilibrio corpo-mente.
          </p>
          <div class="lp-card-grid">
            {prepFeatures.map((f, i) => (
              <div class="lp-feat-card" data-anim="true" data-anim-delay={String(i * 90)}>
                <span class="lp-feat-card__icon-wrap">
                  <svg class="lp-feat-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={prepIcons[i]} />
                </span>
                <h3 class="lp-feat-card__title">{f.titolo}</h3>
                <p class="lp-feat-card__text">{f.testo}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lp-prep__media">
          <div class="lp-gallery">
            <div class="lp-gallery__nav">
              <button class="lp-gallery__navbtn" type="button" data-gallery-nav="-1" aria-label="Foto precedenti">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="lp-gallery__navbtn" type="button" data-gallery-nav="1" aria-label="Foto successive">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="lp-gallery__track" data-lp-gallery-track>
              {prepGallery.map((g, i) => (
                <button type="button" class={`lp-gallery__item lp-gallery__item--${g.size}`}
                        data-gallery-item aria-label={`Ingrandisci: ${g.alt}`}>
                  <img src={g.src} alt={g.alt} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="lp-lightbox" data-lp-lightbox hidden>
        <button type="button" class="lp-lightbox__close" data-lightbox-close aria-label="Chiudi">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <img class="lp-lightbox__img" data-lightbox-img src="" alt="" />
      </div>

      <div class="lp-planning">
        <span class="eyebrow">Planning corsi</span>
        <h3 class="lp-planning__title">La settimana in palestra</h3>
        <p class="lp-lead">
          Oltre 80 sessioni a settimana guidate da istruttori certificati.
          Ecco come si compone la tua settimana di allenamento.
        </p>
        <WeeklySchedule />
      </div>

      <div class="lp-actions lp-actions--center">
        <button class="btn btn-red" data-open-modal="modal-contatti">Prenota una visita</button>
        <button class="btn btn-outline--dark" data-open-modal="modal-contatti">Richiedi informazioni</button>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ COMMUNITY ═══════════════════ -->
  <section class="lp-community" id="community">
    <div class="lp-community__inner">
      <div class="lp-community__body">
        <span class="eyebrow">Vita di Club</span>
        <h2 class="lp-title">Il campo unisce,<br><em>gli eventi fanno il resto</em></h2>
        <p class="lp-lead">
          Al TCA le relazioni nascono con naturalezza: un saluto durante il
          riscaldamento, una chiacchierata mentre si aspetta il campo libero,
          una partita di doppio che diventa un appuntamento fisso ogni
          settimana. È l'atmosfera di un Circolo che si vive da generazioni,
          dove soci di ogni età si ritrovano prima ancora di essersi
          presentati.
        </p>

        <div class="lp-appendix">
          <p>
            <strong>Un Club vissuto 365 giorni l'anno.</strong> Il calendario
            di eventi trasforma ogni stagione in un'occasione per stare
            insieme: aperitivi in terrazza al tramonto, tornei sociali aperti
            a tutti i livelli, feste a tema e giornate pensate per le
            famiglie. Il campo è dove si gioca; gli eventi sono dove le
            amicizie si rafforzano — e dove il TCA smette di essere solo un
            circolo sportivo per diventare una seconda casa.
          </p>
        </div>

        <div class="lp-card-grid">
          {communityFeatures.map((f, i) => (
            <div class="lp-feat-card" data-anim="true" data-anim-delay={String(i * 90)}>
              <span class="lp-feat-card__icon-wrap">
                <svg class="lp-feat-card__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={vitaIcons[i]} />
              </span>
              <h3 class="lp-feat-card__title">{f.titolo}</h3>
              <p class="lp-feat-card__text">{f.testo}</p>
            </div>
          ))}
        </div>

        <div class="lp-actions">
          <button class="btn btn-red" data-open-modal="modal-contatti">Prenota una visita</button>
          <button class="btn btn-outline--dark" data-open-modal="modal-contatti">Richiedi informazioni</button>
        </div>
      </div>
      <div class="lp-community__media">
        <img src={communityImg} alt="Due socie del TC Ambrosiano brindano in terrazza a bordo campo"
             loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PERCHÉ SCEGLIERCI ═══════════════════ -->
  <Reassurance lang={lang} />

  <!-- ═══════════════════ CTA FINALE ═══════════════════ -->
  <section class="lp-cta" id="visita">
    <div class="lp-cta__inner">
      <span class="eyebrow eyebrow--light">Vieni a conoscerci</span>
      <h2 class="lp-cta__title">Prenota una visita gratuita,<br><em>senza impegno</em></h2>
      <p class="lp-cta__sub">
        Ti accompagniamo noi tra campi, palestra e struttura. Oppure lasciaci i
        tuoi dati e ti richiamiamo: scegli tu come preferisci essere seguito.
      </p>
      <div class="lp-actions lp-actions--center">
        <button class="btn btn-red" data-open-modal="modal-contatti">Prenota la tua visita</button>
        <button class="btn btn-outline" data-open-modal="modal-contatti">Richiedi informazioni</button>
      </div>
      <p class="lp-cta__refs">
        Via Feltre 33, Milano &nbsp;·&nbsp; Metro Udine (M2) &nbsp;·&nbsp;
        <a href="tel:+390226414392">+39 02 2641 4392</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ Hero + stats nella stessa schermata iniziale (solo desktop) ═══ */
  @media (min-width: 901px) {
    .lp-hero-group {
      height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .lp-hero-group .lp-hero {
      flex: 1 1 auto;
      min-height: 0;
    }
    .lp-hero-group .lp-stats {
      flex: 0 0 auto;
    }
  }

  /* ═══════════════════ HERO ═══════════════════ */
  .lp-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-top: var(--header-h);
  }
  .lp-hero__bg { position: absolute; inset: 0; overflow: hidden; }
  .lp-hero__img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 30%;
    display: block;
  }
  .lp-hero__grad {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(15,15,18,0.35) 0%, rgba(15,15,18,0.68) 55%, rgba(15,15,18,0.85) 100%);
  }
  .lp-hero__content {
    position: relative; z-index: 2;
    width: 100%; max-width: var(--max-width);
    margin: 0 auto; padding: 10vh var(--pad-x) 9vh;
    color: #fff;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .lp-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6.5vw, 7rem);
    font-weight: 800; text-transform: uppercase;
    letter-spacing: -0.01em; line-height: 0.94;
    margin: 0.6rem 0 2.5vh; max-width: 20ch;
  }
  .lp-hero__title em { color: var(--color-accent); font-style: normal; }
  .lp-hero__break--mobile { display: none; }
  .lp-hero__sub {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.3vw, 21px);
    font-weight: 300; line-height: 1.75;
    color: rgba(255,255,255,0.82);
    max-width: 58ch; margin: 0 auto 4vh;
  }
  .lp-hero__sub strong { font-weight: 800; color: #fff; }
  .lp-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  /* ═══════════════════ STATS ═══════════════════ */
  .lp-stats {
    background: var(--color-text);
    color: #fff;
  }
  .lp-stats__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .lp-stat {
    padding: 5vh var(--pad-x);
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.12);
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .lp-stat:last-child { border-right: none; }
  .lp-stat__num {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    font-weight: 800; line-height: 1;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }
  .lp-stat__label {
    font-family: var(--font-body);
    font-size: clamp(12px, 0.95vw, 14px);
    font-weight: 300; line-height: 1.4;
    color: rgba(255,255,255,0.72);
  }

  /* ═══════════════════ TITOLI CONDIVISI ═══════════════════ */
  .lp-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.2vw, 4.2rem);
    font-weight: 800; text-transform: uppercase;
    letter-spacing: -0.01em; line-height: 0.95;
    margin: 0.5rem 0 1.25rem;
    color: var(--color-text);
  }
  .lp-title em { color: var(--color-accent); font-style: normal; }
  .lp-lead {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.05vw, 19px);
    font-weight: 300; line-height: 1.8;
