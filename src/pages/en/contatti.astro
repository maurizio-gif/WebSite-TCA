---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const lang = 'en' as const;

// SEO gestibile da TinaCMS → src/content/pagine/contatti.md (campi _en)
// Pagina landing a schermo intero (usata per link diretti/QR code): solo
// il form, senza navbar/footer né testo introduttivo. Vedi hideChrome e
// leadFormStandalone su BaseLayout.
const d = (await getEntry("pagine", "contatti"))!.data;
---

<BaseLayout
  lang={lang}
  title={d.title_en ?? d.title}
  description={d.description_en ?? d.description}
  image={d.hero_immagine}
  imageAlt={d.hero_immagine_alt_en ?? d.hero_immagine_alt}
  hideChrome
  leadFormStandalone
>
</BaseLayout>
