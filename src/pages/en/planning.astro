---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WeeklySchedule from "../../components/WeeklySchedule.astro";
import { getEntry } from "astro:content";

const lang = 'en' as const;

// SEO + intestazione gestibili da TinaCMS → src/content/pagine/planning.md (campi _en)
const d = (await getEntry("pagine", "planning"))!.data;
---

<BaseLayout lang={lang} title={d.title_en ?? d.title} description={d.description_en ?? d.description}>
  <div class="page-header">
    <div class="page-header__inner">
      <span class="eyebrow">{d.hero_eyebrow_en ?? d.hero_eyebrow}</span>
      <h1 class="page-header__title">{d.hero_titolo_en ?? d.hero_titolo}</h1>
      <p class="page-header__sub">{d.hero_sottotitolo_en ?? d.hero_sottotitolo}</p>
    </div>
  </div>

  <section class="planning-section">
    <div class="planning-section__inner">
      <p class="planning-print-title">TC Ambrosiano — {d.hero_titolo_en ?? d.hero_titolo}</p>
      <div class="planning-toolbar">
        <button type="button" class="btn btn-outline--dark planning-print-btn" id="planning-print">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M6 14h12v7H6v-7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Print / Save PDF
        </button>
      </div>
      <WeeklySchedule lang="en" />
    </div>
  </section>

  <div class="planning-cta">
    <a class="btn btn-red" href="/en/preparazione-atletica#membership">Become a Member</a>
    <a class="btn btn-outline--dark" href="/en/preparazione-atletica">Back to Athletic Training</a>
  </div>
</BaseLayout>

<script>
  document.getElementById('planning-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .page-header {
    padding: calc(var(--header-h) + 6vh) var(--pad-x) 5vh;
    background: var(--color-off-white);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .page-header__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.92;
    margin-bottom: 1.5vh;
  }

  .page-header__sub {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.1vw, 20px);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-text-light);
  }

  .planning-section {
    padding: 6vh var(--pad-x);
  }

  .planning-section__inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .planning-cta {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--pad-x) 8vh;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .planning-toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .planning-print-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Titolo compatto visibile solo in stampa, al posto del page-header decorativo */
  .planning-print-title {
    display: none;
  }

  /* ── Stampa: planning su una pagina A4 verticale, senza header/CTA ── */
  @media print {
    @page {
      size: A4 portrait;
      margin: 12mm;
    }

    .page-header,
    .planning-toolbar,
    .planning-cta {
      display: none !important;
    }

    .planning-section { padding: 0; }

    .planning-print-title {
      display: block;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      color: #000;
      margin: 0 0 10px;
    }
  }
</style>
