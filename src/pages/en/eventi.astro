---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import EventiHome from "../../components/EventiHome.astro";
import { getEntry } from "astro:content";

const lang = 'en' as const;

// SEO + hero gestibili da TinaCMS → src/content/pagine/eventi.md (campi _en)
const d = (await getEntry("pagine", "eventi"))!.data;
---

<BaseLayout
  lang={lang}
  title={d.title_en ?? d.title}
  description={d.description_en ?? d.description}
  image={d.hero_immagine}
  imageAlt={d.hero_immagine_alt_en ?? d.hero_immagine_alt}
>
  <PageHero
    eyebrow={d.hero_eyebrow_en ?? d.hero_eyebrow}
    title={(d.hero_titolo_en ?? d.hero_titolo)!}
    titleAccent={d.hero_titolo_accent_en ?? d.hero_titolo_accent}
    sub={d.hero_sottotitolo_en ?? d.hero_sottotitolo}
    image={d.hero_immagine!}
    imageAlt={(d.hero_immagine_alt_en ?? d.hero_immagine_alt)!}
  />

  <EventiHome lang={lang} limit={100} showAllLink={false} />

</BaseLayout>
