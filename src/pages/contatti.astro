---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

// SEO gestibile da TinaCMS → src/content/pagine/contatti.md
// Pagina landing a schermo intero (usata per link diretti/QR code): solo
// il form, senza navbar/footer né testo introduttivo. Vedi hideChrome e
// leadFormStandalone su BaseLayout.
const d = (await getEntry("pagine", "contatti"))!.data;
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={d.hero_immagine}
  imageAlt={d.hero_immagine_alt}
  hideChrome
  leadFormStandalone
  leadFormTitle="Registrazione Guest"
>
</BaseLayout>
